        self.log("Clicking Vessel List download icon button...")
        js = """
        const icons = Array.from(document.querySelectorAll('mat-icon'));
        for (const i of icons) {
            const txt = (i.innerText || i.textContent || '').trim().toLowerCase();
            if (txt === 'filedownload' || txt === 'download') {
                const btn = i.closest('button');
                if (btn) { btn.click(); return 'clicked mat-icon ' + txt; }
            }
        }
        const btns = Array.from(document.querySelectorAll('button'));
        for (const b of btns) {
            const lbl = (b.getAttribute('aria-label') || '').toLowerCase();
            const cls = (b.className || '').toLowerCase();
            const ttip = ((b.getAttribute('mattooltip') || b.getAttribute('title') || '') + '').toLowerCase();
            if (lbl.includes('download') || cls.includes('download') || ttip.includes('download')) {
                b.click();
                return 'clicked aria/class/tooltip';
            }
        }
        return null;
        """
        # Slow network / slow page render: the button may simply not exist in
        # the DOM yet on the first check. Poll for up to ~20s instead of
        # giving up on a single immediate attempt.
        result = None
        for attempt in range(20):
            result = self.driver.execute_script(js)
            if result:
                break
            time.sleep(1.0)
        if not result:
            try:
                shot = os.path.join(DOWNLOADDIR, f"debug_vessellist_btn_missing_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")
