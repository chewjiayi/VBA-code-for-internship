            if len(alldp2) >= 2:
                end_el = alldp2[1]
                self.log("Vessel end date: re-fetched fallback to second mat-datepicker-input")

        if end_el:
            self.pickdate(end_el, dateto)
            _t.sleep(0.4)
        else:
            self.log("WARNING: Vessel List end date field not found — skipping")

