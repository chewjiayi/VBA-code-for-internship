    def createoutlookemail(self, finalpath, htmlbody, seldate, vesselfilter):
        """
        Schedule Outlook to open on the MAIN thread (required for COM UI / message pump).
        Uses threading.Event so the background thread can wait and confirm it ran.
        Excel must already be fully released before calling this.
        """
        if win32com is None:
            self.log("pywin32 not available — cannot open Outlook.", "#ef4444")
            return

        done = threading.Event()
        errors = []

        def _on_main_thread():
            try:
                import pythoncom
                pythoncom.CoInitialize()
                self.log("Starting Outlook...")
                outlook = win32com.client.dynamic.Dispatch("Outlook.Application")
                mail = outlook.CreateItem(0)
                mail.Subject = f"PSA Overstow Report {seldate.strftime('%d %b %Y')} {vesselfilter or 'All Vessels'}"
                mail.HTMLBody = htmlbody
                mail.BodyFormat = 2
                if finalpath and os.path.exists(finalpath):
                    mail.Attachments.Add(finalpath)
                mail.Display(False)
                self.log("Outlook email draft opened — please review and send.")
            except Exception as e:
                errors.append(e)
                self.log(f"Outlook error: {e}", "#ef4444")
                self.log(traceback.format_exc(), "#ef4444")
            finally:
                done.set()

        self.root.after(0, _on_main_thread)
        # Wait up to 30 seconds for the main thread to finish opening Outlook
        done.wait(timeout=30)
        if errors:
            raise Exception(f"Outlook failed: {errors[0]}")

    def run(self, psauser, psapass, spuser, sppass, vesselfilter, datefrom, dateto):
        try:
            from selenium.webdriver.support.ui import WebDriverWait

            self.progress(5, "Setting up browser...")
            self.driver = self.setupbrowser()
            self.driver.implicitly_wait(2)

            self.progress(8, "Step 1: Logging into PSA portal...")
            self.driver.get(PSAVESSELURL)
            self.waitpageready(0.8)
            self.psalogin(None, psauser, psapass)

            self.progress(12, "Step 2: Downloading Vessel List...")
            self.driver.get(PSAVESSELURL)
            self.waitpageready(1.0)
            self.psasetvestseldates(datefrom, dateto)
            self.psaclickvessellistdownload()
            vesselfile = self.waitfornewfile("vessel", timeout=90)
            if not vesselfile:
                raise Exception("Vessel List file not downloaded")

            self.progress(22, "Step 3: Downloading Load Vessel List...")
            self.driver.get(PSALOADURL)
            self.waitpageready(0.8)
            self.psasetdateanddownload(datefrom, dateto, "Load Vessel List", clickown=True)
            loadfile = self.waitfornewfile("load", timeout=90)
            if not loadfile:
                try:
                    shot = os.path.join(DOWNLOADDIR, f"debug_load_vessel_fail_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")
                    self.driver.save_screenshot(shot)
                    self.log(f"Saved failure screenshot: {shot}", "#f59e0b")
                except Exception:
                    pass
                raise Exception("Load Vessel List file not downloaded")

            self._spuser = spuser
            self._sppass = sppass

            self.progress(52, "Step 4: Downloading Yard Buildup Quality...")
            yardfile = self.spdownload(None, SPURLYARD, "YardBuildupQuality", datefrom)
            if not yardfile:
                raise Exception("Yard Buildup Quality file not downloaded")

            self.progress(64, "Step 5: Downloading Self Service file...")
            servfile = self.spdownload(None, SPURLSERVICING, "Servicing", datefrom)
            if not servfile:
                raise Exception("Self Service file not downloaded")

            if self.driver:
                try:
                    self.driver.quit()
                except Exception:
                    pass
                self.driver = None

            self.progress(70, "Step 6: Locating Distance.xlsx...")
            distancefile = self.finddistancefile()
            if distancefile:
                self.log(f"Found Distance.xlsx: {distancefile}")
            else:
                self.log("Distance.xlsx not found — continuing without it.", "#f59e0b")

            self.progress(74, "Step 7: Processing data...")
            finalpath, htmlbody = self.processdata(vesselfile, loadfile, yardfile, servfile, vesselfilter, datefrom, distancefile)

            self.progress(90, "Step 8: Creating Outlook email draft...")
            self.log("Opening Outlook — Excel is fully released, safe to proceed...")
            self.createoutlookemail(finalpath, htmlbody, datefrom, vesselfilter)

            self.progress(100, "All done")
            self.finish(ok=True, finalpath=finalpath)

        except Exception as e:
            self.log(f"Fatal error: {e}")
            self.log(traceback.format_exc())
            try:
                self.finish(ok=False)
            except Exception as fe:
                logtofile(f"finish(ok=False) itself raised: {fe}")
            try:
                if self.driver:
                    self.driver.quit()
            except Exception as qe:
                logtofile(f"driver.quit() during error cleanup failed (ignored): {qe}")
            finally:
                self.driver = None

def install_error_handlers(root):
    """
    Catch errors that would otherwise fail silently or crash with no
    trace, and log/report them instead. This is purely a safety net for
    handover — it does not change any normal-path behavior.
    """
    def tk_callback_error(exc, val, tb):
        msg = "".join(traceback.format_exception(exc, val, tb))
        logtofile(f"Unhandled Tk callback error:\n{msg}")
        try:
            messagebox.showerror("Unexpected Error", f"Something went wrong:\n{val}\n\nDetails were written to:\n{LOGFILE}")
        except Exception:
            pass
    root.report_callback_exception = tk_callback_error

    def excepthook(exc_type, exc_value, exc_tb):
        msg = "".join(traceback.format_exception(exc_type, exc_value, exc_tb))
        logtofile(f"Unhandled top-level error:\n{msg}")
        try:
            messagebox.showerror("Fatal Error", f"The application hit an unexpected error and needs to close.\n\nDetails were written to:\n{LOGFILE}")
        except Exception:
            pass
    sys.excepthook = excepthook

if __name__ == "__main__":
    try:
        root = tk.Tk()
        install_error_handlers(root)
        app = PSAApp(root)
        root.mainloop()
    except Exception as e:
        # Last-resort catch so a startup failure (e.g. Tk not available,
        # corrupt config, etc.) is at least written to disk for handover
        # troubleshooting instead of vanishing when the console closes.
        logtofile(f"Fatal startup error: {e}\n{traceback.format_exc()}")
        try:
            messagebox.showerror("Fatal Error", f"The application failed to start:\n{e}\n\nDetails were written to:\n{LOGFILE}")
        except Exception:
            pass
        raise
