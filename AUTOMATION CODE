def pipinstallpackages(*packages):
    for pkg in packages:
        try:
            __import__(pkg.split("==")[0].replace("-", "_"))
        except ImportError:
            installed = False
            for cmd in [
                [sys.executable, "-m", "pip", "install", pkg, "--trusted-host", "pypi.org", "--trusted-host", "files.pythonhosted.org", "--quiet"],
            ]:
                try:
                    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
                    if r.returncode == 0:
                        installed = True
                        break
                    else:
                        print(f"[setup] pip install {pkg} failed (code {r.returncode}): {r.stderr.strip()[:300]}")
                except Exception as e:
                    print(f"[setup] pip install {pkg} raised: {e}")
            if not installed:
                print(f"[setup] WARNING: could not auto-install '{pkg}'. "
                      f"If the app fails to start, run manually: "
                      f"\"{sys.executable}\" -m pip install {pkg}")

pipinstallpackages("pandas", "openpyxl", "selenium", "webdriver-manager")

