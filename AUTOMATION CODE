    def killstrayexcel(self):
        """
        Kill any lingering EXCEL.EXE processes before automation starts.
        A crashed/hung prior run can leave Excel holding a file open in
        Protected View, which then throws 'This file is already open in
        Protected View' on the next Workbooks.Open call.
        """
        try:
            subprocess.run(
                ["taskkill", "/F", "/IM", "EXCEL.EXE", "/T"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=10,
            )
            self.log("Cleared any stray Excel processes.")
            time.sleep(1.0)
        except Exception:
            pass

    def unblockfile(self, path):
        """
        Remove the NTFS Zone.Identifier alternate data stream (the
        'downloaded from the internet' flag) so Excel doesn't force
        Protected View when opening this file.
        """
        try:
            ads = path + ":Zone.Identifier"
            if os.path.exists(ads):
                os.remove(ads)
                self.log(f"Unblocked: {os.path.basename(path)}")
        except Exception:
            pass

    def runmacro(self, vesselfile, loadfile, yardfile, servfile, distancefile=None):
        """
        Open all files (Vessel List, Load Vessel List, Yard Buildup, Servicing,
        Distance.xlsx) + Servicingforvessel.xlsm, run macro Run_All.
        ALL COM calls are dispatched to the main thread via root.after + Event,
        because Excel is an STA COM server and needs the main thread message pump.
        """
        if win32com is None:
            raise Exception("pywin32 not available — please install pywin32.")

        self.log("Searching for Distance.xlsx...")
        if not distancefile:
            distancefile = self.finddistancefile()
        if distancefile:
            self.log(f"Found: {distancefile}")
        else:
            self.log("WARNING: Distance.xlsx not found — continuing without it.", "#f59e0b")

        self.log("Searching for Servicingforvessel.xlsm...")
        macrofile = self.findservicingforvessel()
        if not macrofile:
            raise Exception("Servicingforvessel.xlsm not found. Place it on your Desktop or Downloads folder.")
        self.log(f"Found: {macrofile}")

        self.killstrayexcel()
        for fpath in [vesselfile, loadfile, yardfile, servfile, distancefile, macrofile]:
            if fpath and os.path.exists(fpath):
                self.unblockfile(fpath)

        result = {"macrofile": None, "error": None}
        done = threading.Event()

        def _run_on_main():
            try:
                import pythoncom
                pythoncom.CoInitialize()

                xl = win32com.client.dynamic.Dispatch("Excel.Application")
                xl.Visible = True
                xl.DisplayAlerts = False
                xl.AutomationSecurity = 1  # enable macros

                opened = []
                try:
                    for fpath in [vesselfile, loadfile, yardfile, servfile, distancefile]:
                        if fpath and os.path.exists(fpath):
                            self.log(f"Opening: {os.path.basename(fpath)}")
                            wb = xl.Workbooks.Open(fpath)
                            opened.append(wb)
                        elif fpath:
                            self.log(f"WARNING: File not found, skipping: {fpath}")

                    self.log("Opening Servicingforvessel.xlsm...")
                    macrowb = xl.Workbooks.Open(
                        macrofile,
                        UpdateLinks=False,
                        ReadOnly=False,
                        Format=1,
                        Password="",
                        WriteResPassword="",
                        IgnoreReadOnlyRecommended=True,
                        Notify=False,
                        AddToMru=False,
                        Editable=True,
                    )
                    opened.append(macrowb)

                    wbname = os.path.basename(macrowb.FullName)
                    macroname = f"'{wbname}'!Module1.Run_All"
                    self.log(f"Running macro: {macroname}")
                    xl.Run(macroname)
                    self.log("Macro completed successfully.")
                    result["macrofile"] = macrofile

                finally:
                    xl.DisplayAlerts = True
                    xl.AutomationSecurity = 2
                    # Close workbooks and quit Excel cleanly
                    for wb in list(opened):
                        try:
                            wb.Close(SaveChanges=False)
                        except Exception:
                            pass
                    try:
                        xl.Quit()
                    except Exception:
                        pass
                    import gc
                    gc.collect()
                    self.log("Excel released.")

            except Exception as e:
                result["error"] = e
                self.log(f"Excel/macro error: {e}", "#ef4444")
                if "Protected View" in str(e):
                    self.log("Hint: an Excel window may still be holding one of these files open. "
                              "Close all Excel windows manually and re-run.", "#f59e0b")
                self.log(traceback.format_exc(), "#ef4444")
            finally:
                done.set()

        self.root.after(0, _run_on_main)
        self.log("Waiting for Excel macro to complete on main thread...")
        done.wait(timeout=300)  # up to 5 min for macro to finish

        if result["error"]:
            raise Exception(f"Macro failed: {result['error']}")
        if not result["macrofile"]:
            raise Exception("Macro did not complete — timed out or unknown error.")

        return result["macrofile"]

