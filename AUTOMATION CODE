    def log(self, msg, color="#22c55e"):
        # Persist every log line to disk too, so a handover engineer can
        # diagnose a failed run after the fact (the on-screen log box is
        # lost once the window is closed). This never raises.
        logtofile(msg)

        def do():
            try:
                self.logbox.configure(state="normal")
                ts = datetime.now().strftime("%H:%M:%S")
                self.logbox.insert("end", f"[{ts}] {msg}\n")
                self.logbox.see("end")
                self.logbox.configure(state="disabled")
            except Exception:
                # UI may already be torn down (e.g. window closed) — the
                # message is still safely in LOGFILE via logtofile() above.
                pass
        try:
            self.root.after(0, do)
        except Exception:
            pass

    def progress(self, pct, step):
        def do():
            self.progvar.set(pct)
            self.pctlbl.config(text=f"{int(pct)}%")
            self.steplbl.config(text=step)
        self.root.after(0, do)

    def finish(self, ok=True, finalpath=None):
        def do():
            self.steplbl.config(text="Done!" if ok else "Error")
            self.progvar.set(100 if ok else self.progvar.get())
            if finalpath:
                self.log(f"FINAL.xlsx saved: {finalpath}")
            self.startbtn.config(state="normal")
            self.cancelbtn.config(state="disabled")
            tk.Button(self.pw, text="Close", font=("Segoe UI", 10), bg="#3b82f6" if ok else "#ef4444", fg="white", relief="flat", padx=20, pady=6, command=self.pw.destroy).pack(pady=(8, 16))
        self.root.after(0, do)

    def start(self):
        if not self.psauser.get().strip() or not self.psapass.get().strip() or not self.spuser.get().strip() or not self.sppass.get().strip():
            messagebox.showerror("Missing", "Please fill all login fields.")
            return
        try:
            datefrom = datetime.strptime(self.datefromvar.get().strip(), "%d%m%Y")
            dateto = datetime.strptime(self.datetovar.get().strip(), "%d%m%Y")
        except ValueError:
            messagebox.showerror("Invalid Date", "Use ddmmyyyy.")
            return
        if dateto < datefrom:
            messagebox.showerror("Invalid Range", "Date TO cannot be before Date FROM.")
            return
        saveconfig({"psauser": self.psauser.get().strip(), "spuser": self.spuser.get().strip(), "datefrom": self.datefromvar.get().strip(), "dateto": self.datetovar.get().strip()})
        self.startbtn.config(state="disabled")
        self.cancelbtn.config(state="normal")
        self.cancelled = False
        try:
            self.openprogress()
            threading.Thread(target=self.run, args=(self.psauser.get().strip(), self.psapass.get().strip(), self.spuser.get().strip(), self.sppass.get().strip(), self.vesselvar.get().strip().upper(), datefrom, dateto), daemon=True).start()
        except Exception as e:
            # If the worker thread fails to even start, don't leave the UI
            # stuck in a disabled state — restore it and tell the user.
            logtofile(f"Failed to start automation thread: {e}\n{traceback.format_exc()}")
            self.startbtn.config(state="normal")
            self.cancelbtn.config(state="disabled")
            messagebox.showerror("Startup Error", f"Could not start automation:\n{e}")

    def cancel(self):
        self.cancelled = True
        if self.driver:
            try:
                self.driver.quit()
            except Exception as e:
                logtofile(f"cancel(): driver.quit() error (ignored): {e}")
            finally:
                self.driver = None
        try:
            self.finish(ok=False)
        except Exception as e:
            logtofile(f"cancel(): finish() error: {e}")

    def setupbrowser(self):
        from selenium import webdriver
        from selenium.webdriver.edge.options import Options as EdgeOptions
        from selenium.webdriver.edge.service import Service as EdgeService

        os.makedirs(DOWNLOADDIR, exist_ok=True)
        dlprefs = {
            "download.default_directory": DOWNLOADDIR,
            "download.prompt_for_download": False,
            "download.directory_upgrade": True,
            "safebrowsing.enabled": True,
        }
        commonargs = [
            "--start-maximized", "--disable-notifications", "--disable-popup-blocking",
            "--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu",
            "--ignore-certificate-errors", "--allow-insecure-localhost",
        ]

        def make_edge():
            opts = EdgeOptions()
            opts.add_experimental_option("prefs", dlprefs)
            for a in commonargs:
                opts.add_argument(a)
            return opts

        # 1. msedgedriver.exe next to script, Downloads, or Desktop
        scriptdir = os.path.dirname(os.path.abspath(__file__)) if "__file__" in globals() else os.getcwd()
        for ep in [
            os.path.join(scriptdir, "msedgedriver.exe"),
            os.path.join(os.path.expanduser("~"), "Downloads", "msedgedriver.exe"),
            os.path.join(os.path.expanduser("~"), "Desktop", "msedgedriver.exe"),
        ]:
            if os.path.exists(ep):
                try:
                    self.log(f"Using msedgedriver.exe: {ep}")
                    return webdriver.Edge(service=EdgeService(ep), options=make_edge())
                except Exception as e:
                    self.log(f"msedgedriver.exe failed: {e}")

        # 2. Selenium 4.6+ auto-detect (msedgedriver on PATH)
        try:
            self.log("Trying Edge auto-detect...")
            return webdriver.Edge(options=make_edge())
        except Exception as e:
            self.log(f"Edge auto-detect failed: {e}")

        # 3. webdriver_manager with SSL verify disabled (corporate network)
        try:
            import os as _os
            _os.environ["WDM_SSL_VERIFY"] = "0"
            from webdriver_manager.microsoft import EdgeChromiumDriverManager
            import requests as _req
            _orig = _req.get
            _req.get = lambda *a, **kw: _orig(*a, **{**kw, "verify": False})
            try:
                ep = EdgeChromiumDriverManager().install()
                return webdriver.Edge(service=EdgeService(ep), options=make_edge())
            finally:
                _req.get = _orig
        except Exception as e:
            self.log(f"EdgeChromiumDriverManager failed: {e}")

        raise Exception(
            "Could not start Edge browser.\n\n"
            "Please download msedgedriver.exe matching your Edge version (148) from:\n"
            "https://developer.microsoft.com/en-us/microsoft-edge/tools/webdriver/\n"
            "and place it in the same folder as this script."
        )

    def waitpageready(self, minwait=0.3, timeout=12):
        start = time.time()
        while time.time() - start < timeout:
            try:
                if self.driver.execute_script("return document.readyState") == "complete":
                    if time.time() - start >= minwait:
                        return
            except Exception:
                pass
            time.sleep(0.15)

    def waitfornewfile(self, keyword, timeout=90):
        before = set(glob.glob(os.path.join(DOWNLOADDIR, "*.xlsx")) + glob.glob(os.path.join(DOWNLOADDIR, "*.xlsm")))
        start = time.time()
        while time.time() - start < timeout:
            if glob.glob(os.path.join(DOWNLOADDIR, "*.crdownload")):
                time.sleep(0.3)
                continue
            now = set(glob.glob(os.path.join(DOWNLOADDIR, "*.xlsx")) + glob.glob(os.path.join(DOWNLOADDIR, "*.xlsm")))
            new = [f for f in (now - before) if "FINAL" not in os.path.basename(f).upper()]
            if new:
                return max(new, key=os.path.getmtime)
            time.sleep(0.5)
        return None

    def pickdate(self, inp, dt):
        """
        Open the Angular Material date-picker for `inp` and select `dt`.
        Navigates the calendar in BOTH directions (prev/next) so it works
        regardless of which month the picker opens on.
        Also re-fetches the calendar header each iteration to handle Angular
        re-renders after the start-date picker closes.
        """
        from selenium.webdriver.common.by import By
        from selenium.webdriver.support.ui import WebDriverWait
        from selenium.webdriver.support import expected_conditions as EC

        try:
            self.driver.execute_script("arguments[0].scrollIntoView({block:'center'});", inp)
            time.sleep(0.2)

            # The input is readonly — we must click the calendar ICON BUTTON
            # (mat-datepicker-toggle button, aria-label="Open calendar") next to it,
            # not the input itself.  Walk up from the input to find the toggle sibling.
            opened = False
            try:
                # Find the wrapping mat-form-field or nearest shared parent, then
                # look for the toggle button inside it.
                toggle_btn = self.driver.execute_script("""
                    var inp = arguments[0];
                    // Try sibling mat-datepicker-toggle inside the same form-field wrapper
                    var parent = inp.closest('mat-form-field') || inp.closest('.mat-mdc-form-field') || inp.parentElement;
                    for (var i = 0; i < 5; i++) {
                        if (!parent) break;
                        var btn = parent.querySelector('mat-datepicker-toggle button, button[aria-label*="calendar"], button[aria-haspopup="dialog"]');
                        if (btn) return btn;
                        parent = parent.parentElement;
                    }
                    return null;
                """, inp)
                if toggle_btn:
                    self.driver.execute_script("arguments[0].click();", toggle_btn)
                    self.log(f"Opened calendar via toggle button for {dt.strftime('%d/%m/%Y')}")
                    opened = True
                    time.sleep(0.4)
            except Exception as te:
                self.log(f"Toggle button search failed: {te}")

            if not opened:
                # Fallback: click the input directly (some Angular versions allow it)
                try:
                    inp.click()
                except Exception:
                    self.driver.execute_script("arguments[0].click();", inp)
                time.sleep(0.4)

            # Wait for the calendar popup to appear
            try:
                WebDriverWait(self.driver, 6).until(
                    EC.presence_of_element_located((By.CSS_SELECTOR, "mat-calendar"))
                )
            except Exception:
                # Last resort: try clicking the toggle button by aria-label globally
                self.log(f"Calendar not visible — trying global aria-label search")
                try:
                    btns = self.driver.find_elements(By.CSS_SELECTOR, "button[aria-label*='calendar'], button[aria-haspopup='dialog']")
                    for b in btns:
                        if b.is_displayed():
                            self.driver.execute_script("arguments[0].click();", b)
                            time.sleep(0.5)
                            break
                except Exception:
                    pass

            target_month = dt.month   # 1-12
            target_year  = dt.year

            for _ in range(36):   # max 3 years of navigation
                try:
                    hdr_el = WebDriverWait(self.driver, 3).until(
                        EC.presence_of_element_located(
                            (By.CSS_SELECTOR, "mat-calendar button.mat-calendar-period-button")
                        )
                    )
                    hdr = hdr_el.text.strip().upper()
                except Exception:
                    break

                # Header is typically "JUNE 2026" or "JUN 2026"
                month_match = (
                    dt.strftime("%B").upper() in hdr   # full: JUNE
                    or dt.strftime("%b").upper() in hdr # short: JUN
                )
                year_match = str(target_year) in hdr

                if month_match and year_match:
                    break   # We're on the right month/year

                # Determine direction: parse current calendar month from header
                # Try to detect current month by checking which months are in the header
                import calendar as _cal
                current_cal_year  = None
                current_cal_month = None
                for y_offset in range(-5, 6):
                    yr = target_year + y_offset
                    if str(yr) in hdr:
                        current_cal_year = yr
                        break
                if current_cal_year is not None:
                    for m in range(1, 13):
                        if (
                            _cal.month_name[m].upper() in hdr
                            or _cal.month_abbr[m].upper() in hdr
                        ):
                            current_cal_month = m
                            break

                # Decide: go forward or backward
                go_next = True
                if current_cal_year is not None and current_cal_month is not None:
                    if (current_cal_year, current_cal_month) > (target_year, target_month):
                        go_next = False   # calendar is ahead — go back

                nav_sel = (
                    "mat-calendar button.mat-calendar-next-button"
                    if go_next else
                    "mat-calendar button.mat-calendar-previous-button"
                )
                try:
                    self.driver.find_element(By.CSS_SELECTOR, nav_sel).click()
                except Exception:
                    break
                time.sleep(0.18)

            
            aria_variants = [
                dt.strftime("%m/%d/%Y"),              # 06/04/2026  <-- PSA site format
                dt.strftime("%d/%m/%Y"),              # 04/06/2026  (DD/MM/YYYY variant)
                dt.strftime("%B %d, %Y").replace(" 0", " "),  # June 4, 2026
                dt.strftime("%B %d, %Y"),             # June 04, 2026
                dt.strftime("%b %d, %Y").replace(" 0", " "),  # Jun 4, 2026
                dt.strftime("%b %d, %Y"),             # Jun 04, 2026
                dt.strftime("%Y-%m-%d"),              # 2026-06-04
            ]
            # Remove duplicates while preserving order
            seen = set()
            aria_variants = [v for v in aria_variants if not (v in seen or seen.add(v))]

            self.log(f"Trying day aria-labels: {aria_variants[:4]}...")

            clicked = False
            for aria in aria_variants:
                for xp in [
                    f"//button[contains(@class,'mat-calendar-body-cell') and @aria-label='{aria}']",
                    f"//button[contains(@class,'mat-calendar-body-cell') and contains(@aria-label,'{aria}')]",
                    f"//td[contains(@class,'mat-calendar-body-cell') and @aria-label='{aria}']",
                    f"//td[contains(@class,'mat-calendar-body-cell') and contains(@aria-label,'{aria}')]",
                    f"//*[@aria-label='{aria}']",
                ]:
                    try:
                        dayel = WebDriverWait(self.driver, 1).until(
                            EC.element_to_be_clickable((By.XPATH, xp))
                        )
                        self.driver.execute_script("arguments[0].click();", dayel)
                        self.log(f"Clicked day cell with aria-label: {aria}")
                        time.sleep(0.25)
                        clicked = True
                        break
                    except Exception:
                        pass
                if clicked:
                    return True

            # Last-resort fallback: find all visible day cells and match by day number + month text
            if not clicked:
                self.log(f"Aria-label match failed — trying day-number fallback for day {dt.day}")
                try:
                    day_str = str(dt.day)
                    cells = self.driver.find_elements(
                        By.CSS_SELECTOR,
                        "button.mat-calendar-body-cell, td.mat-calendar-body-cell"
                    )
                    for cell in cells:
                        try:
                            content_el = cell.find_element(By.CSS_SELECTOR, ".mat-calendar-body-cell-content")
                            if content_el.text.strip() == day_str and cell.is_displayed():
                                self.driver.execute_script("arguments[0].click();", cell)
                                self.log(f"Clicked day cell by text content: {day_str}")
                                time.sleep(0.25)
                                return True
                        except Exception:
                            pass
                except Exception as fe:
                    self.log(f"Day fallback error: {fe}")

            self.log(f"WARNING: Could not click day cell for {dt.strftime('%d/%m/%Y')}")
        except Exception as ex:
            self.log(f"pickdate error: {ex}")
        return False

