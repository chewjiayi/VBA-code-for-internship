        # Re-fetch the end date element: Angular may re-render the DOM after
        # the start-date calendar closes, making the old stale reference fail.
        end_el = None
        for sel in end_selectors:
            try:
                end_el = WebDriverWait(self.driver, 5).until(
                    EC.presence_of_element_located((By.CSS_SELECTOR, sel))
