    def psaclickdownloadasexcel(self, label):
        from selenium.webdriver.common.by import By
        from selenium.webdriver.support.ui import WebDriverWait
        from selenium.webdriver.support import expected_conditions as EC
        xpaths = [
            "//button[normalize-space()='DOWNLOAD AS EXCEL']",
            "//button[contains(@class,'download-as-excel-btn')]",
            "//*[normalize-space()='DOWNLOAD AS EXCEL' and (self::button or self::a)]",
        ]
        
        max_passes = 3
        for pass_num in range(1, max_passes + 1):
            for xp in xpaths:
                try:
                    # Wait up to 8s per selector — Angular may still be re-rendering
                    # the page right after the terminal dropdown / OWN filter change.
                    btn = WebDriverWait(self.driver,20).until(
                        EC.presence_of_element_located((By.XPATH, xp))
                    )
                    if btn.is_displayed():
                        if not btn.is_enabled() or btn.get_attribute("disabled"):
                            self.log(f"DOWNLOAD AS EXCEL button found but DISABLED for {label} "
                                      f"(likely no data for current terminal/OWN filter) — not clicking.", "#f59e0b")
                            continue
                        self.driver.execute_script("arguments[0].click();", btn)
                        self.log("DOWNLOAD AS EXCEL clicked.")
                        return
                except Exception:
                    continue
            if pass_num < max_passes:
                self.log(f"DOWNLOAD AS EXCEL button not visible yet for {label} "
                          f"(pass {pass_num}/{max_passes}) — page may still be loading, retrying...", "#f59e0b")
                time.sleep(3.0)

        # Nothing matched at all — dump diagnostics so the real selector
        # can be identified without needing live access to the page.
        try:
            texts = self.driver.execute_script("""
                return Array.from(document.querySelectorAll('button'))
                    .map(b => (b.innerText || b.textContent || '').trim())
                    .filter(t => t.length > 0);
            """)
            self.log(f"Buttons visible on page: {texts}", "#f59e0b")
        except Exception:
            pass
        try:
            shot = os.path.join(DOWNLOADDIR, f"debug_download_btn_missing_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")
            self.driver.save_screenshot(shot)
            self.log(f"Saved diagnostic screenshot: {shot}", "#f59e0b")
        except Exception:
            pass
        raise Exception(f"DOWNLOAD AS EXCEL button not found or disabled for {label} (page may not have finished loading — check network)")

