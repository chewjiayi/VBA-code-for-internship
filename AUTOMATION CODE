    def spdownload(self, wait, url, label, targetdate):
        from selenium.webdriver.common.by import By
        from selenium.webdriver.support.ui import WebDriverWait
        from selenium.webdriver.support import expected_conditions as EC

        # Map label to the exact filename in SharePoint
        filemap = {
            "YardBuildupQuality": "Yard_Buildup_Quality.xlsm",
            "Servicing": "Self_Service.xlsm",
        }
        target_filename = filemap.get(label)

        self.log(f"Navigating to SharePoint: {label}...")
        self.driver.get(url)
        self.waitpageready(2.0)
        time.sleep(2.5)

        # Handle Microsoft/SharePoint login redirect
        try:
            for _ in range(3):
                cur = self.driver.current_url.lower()
                if "login.microsoftonline" not in cur and "login.live" not in cur:
                    break
                self.log("SharePoint login prompt detected...")
                # Email field
                for sel in ["input[type='email']", "input[name='loginfmt']"]:
                    try:
                        el = WebDriverWait(self.driver, 6).until(EC.presence_of_element_located((By.CSS_SELECTOR, sel)))
                        el.clear(); el.send_keys(self._spuser); break
                    except Exception:
                        pass
                for xp in ["//*[@id='idSIButton9']", "//input[@type='submit']", "//button[@type='submit']"]:
                    try:
                        self.driver.find_element(By.XPATH, xp).click(); time.sleep(2); break
                    except Exception:
                        pass
                # Password field
                for sel in ["input[type='password']", "input[name='passwd']"]:
                    try:
                        el = WebDriverWait(self.driver, 8).until(EC.presence_of_element_located((By.CSS_SELECTOR, sel)))
                        el.clear(); el.send_keys(self._sppass); break
                    except Exception:
                        pass
                for xp in ["//*[@id='idSIButton9']", "//input[@type='submit']", "//button[@type='submit']"]:
                    try:
                        self.driver.find_element(By.XPATH, xp).click(); time.sleep(2); break
                    except Exception:
                        pass
                # Stay signed in
                for xp in ["//*[@id='idSIButton9']", "//input[@value='Yes']", "//button[contains(.,'Yes')]"]:
                    try:
                        self.driver.find_element(By.XPATH, xp).click(); time.sleep(2); break
                    except Exception:
                        pass
                self.waitpageready(2.0)
                time.sleep(2.0)
        except Exception as e:
            self.log(f"SP login attempt: {e}")

        # Select the target file by clicking its row checkbox
        if target_filename:
            self.log(f"Selecting: {target_filename}")
            base_name = os.path.splitext(target_filename)[0]  # e.g. "Yard_Buildup_Quality"
            base_lower = base_name.lower()

            # SharePoint's modern list is virtualized - a row that isn't
            # currently scrolled into view simply doesn't exist in the DOM
            # yet, so an exact-text XPath search can time out even though
            # the file is right there in the folder. Typing into SharePoint's
            # own search/filter box first forces the matching row to render,
            # regardless of scroll position or sort order.
            try:
                search_box = None
                for sel in ["input[placeholder*='Search']", "input[aria-label*='Search']", "input[type='search']"]:
                    try:
                        search_box = WebDriverWait(self.driver, 5).until(
                            EC.presence_of_element_located((By.CSS_SELECTOR, sel))
                        )
                        break
                    except Exception:
                        continue
                if search_box:
                    self.driver.execute_script("arguments[0].scrollIntoView({block:'center'});", search_box)
                    search_box.click()
                    search_box.clear()
                    search_box.send_keys(base_name)
                    time.sleep(1.5)
                    self.log(f"Filtered SharePoint list via search box: '{base_name}'")
                else:
                    self.log("No SharePoint search box found — relying on direct row match without filtering.")
            except Exception as e:
                self.log(f"Search-filter attempt failed (non-fatal, continuing): {e}")

            clicked = False
            for attempt in range(3):
                try:
                    # Case-insensitive, extension-agnostic match: SharePoint
                    # sometimes splits filename/extension into separate spans,
                    # or the visible text differs slightly in case/spacing —
                    # matching on just the base name is far more forgiving
                    # than the old exact normalize-space() comparison.
                    row_xp = (
                        "//div[@role='row' and .//span["
                        f"contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), '{base_lower}')]] | "
                        "//tr[.//span["
                        f"contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), '{base_lower}')]]"
                    )
                    row = WebDriverWait(self.driver, 12).until(EC.presence_of_element_located((By.XPATH, row_xp)))
                    self.driver.execute_script("arguments[0].scrollIntoView({block:'center'});", row)
                    time.sleep(0.3)
                    try:
                        cb = row.find_element(By.CSS_SELECTOR, "input[type='checkbox'], .ms-Check, [role='checkbox']")
                        self.driver.execute_script("arguments[0].click();", cb)
                    except Exception:
                        self.driver.execute_script("arguments[0].click();", row)
                    clicked = True
                    time.sleep(0.8)
                    break
                except Exception as ex:
                    # Selenium's TimeoutException has no message by default —
                    # spell that out so future logs are actually diagnosable
                    # instead of showing a bare stacktrace.
                    reason = str(ex).strip() or f"{type(ex).__name__} (no message — the row likely never appeared in the DOM within the wait window)"
                    self.log(f"Row select attempt {attempt+1}: {reason}")
                    time.sleep(1.0)

            if not clicked:
                try:
                    link = self.driver.find_element(
                        By.XPATH,
                        f"//a[contains(translate(@href,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz'), '{base_lower}')]"
                    )
                    self.driver.execute_script("arguments[0].click();", link)
                    time.sleep(0.8)
                    clicked = True
                except Exception as ex:
                    self.log(f"Link fallback failed: {ex}")

            if not clicked:
                # Don't fall through to blindly clicking Download with
                # nothing selected — that can silently download the wrong
                # file (or nothing), and the caller would then wait the full
                # 120s timeout for a file that's never coming.
                raise Exception(
                    f"Could not find/select '{target_filename}' in the SharePoint list for '{label}' "
                    f"after search-filter + 3 row-match attempts + link fallback. "
                    f"The file may have been renamed/moved, or SharePoint's page layout changed."
                )

        # Click Download from toolbar
        self.log("Clicking Download...")
        downloaded = False
        for xp in [
            "//button[normalize-space()='Download']",
            "//a[normalize-space()='Download']",
            "//*[@data-automationid='downloadCommand']",
            "//*[@aria-label='Download']",
            "//span[normalize-space()='Download']/ancestor::button",
            "//i[contains(@data-icon-name,'Download')]/ancestor::button",
        ]:
            try:
                btn = WebDriverWait(self.driver, 6).until(EC.element_to_be_clickable((By.XPATH, xp)))
                self.driver.execute_script("arguments[0].click();", btn)
                self.log("Download clicked.")
                downloaded = True
                break
            except Exception:
                pass

        # Fallback: right-click context menu
        if not downloaded and target_filename:
            try:
                from selenium.webdriver.common.action_chains import ActionChains
                file_el = self.driver.find_element(By.XPATH, f"//span[normalize-space()='{target_filename}']")
                ActionChains(self.driver).context_click(file_el).perform()
                time.sleep(0.8)
                dl_menu = WebDriverWait(self.driver, 5).until(
                    EC.element_to_be_clickable((By.XPATH,
                        "//span[normalize-space()='Download'] | //button[normalize-space()='Download']"))
                )
                self.driver.execute_script("arguments[0].click();", dl_menu)
                self.log("Download via context menu clicked.")
                downloaded = True
            except Exception as ex:
                self.log(f"Context menu download failed: {ex}")

        if not downloaded:
            self.log(f"WARNING: Could not click Download for {label} — waiting for file anyway.")

        return self.waitfornewfile(label, timeout=120)

