            "input.banner-input-end-date",
            "input[class*='banner-input-end-date']",
            "input.mat-datepicker-input[formcontrolname='endDateFormControl']",
            "input.mat-datepicker-input[formcontrolname*='end']",
        ]

        start_el = None
        for sel in start_selectors:
            try:
                start_el = WebDriverWait(self.driver, 5).until(
                    EC.presence_of_element_located((By.CSS_SELECTOR, sel))
                )
                self.log(f"Vessel start date field found: {sel}")
