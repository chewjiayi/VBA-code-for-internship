Private Sub PromptDistanceBerth(ByVal wbDist As Workbook)
    If wbDist Is Nothing Then Exit Sub

    Dim wsDist As Worksheet
    Set wsDist = wbDist.Worksheets(1)

    Dim noteCell As Range
    Set noteCell = wsDist.Rows(1).Find(What:="Key in the berth number", _
        LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
    If noteCell Is Nothing Then
        Set noteCell = wsDist.Cells(1, 7) ' fallback: G1
    End If

    Dim valueCell As Range
    Set valueCell = wsDist.Cells(noteCell.Row, noteCell.Column - 1) ' column F

    Dim berthInput As String
    berthInput = InputBox( _
        "Enter the berth number to look up Load / Disc distance in Distance.xlsx" & vbCrLf & vbCrLf & _
        "(e.g. 38)", _
        "Distance Lookup - Berth Number", CStr(valueCell.Value))

    If StrPtr(berthInput) = 0 Then Exit Sub
    berthInput = Trim$(berthInput)
    If Len(berthInput) = 0 Then Exit Sub

    If Not IsNumeric(berthInput) Then
        MsgBox "Berth number must be numeric. Distance lookup value not changed.", vbExclamation
        Exit Sub
    End If

    valueCell.Value = CLng(berthInput)
    wbDist.Application.Calculate
End Sub

Private Function GetARMGBlockList_FromDistance(ByVal wbDist As Workbook) As String
    Const RED_THRESHOLD As Double = 2501
    If wbDist Is Nothing Then
        GetARMGBlockList_FromDistance = ""
        Exit Function
    End If
    Dim wsD As Worksheet
    On Error Resume Next
    Set wsD = wbDist.Worksheets("Sheet1")
    On Error GoTo 0
    If wsD Is Nothing Then Set wsD = wbDist.Worksheets(1)
    Dim hdrRow As Long
    hdrRow = FindHeaderRowExact(wsD, "Equipment", 15)
    If hdrRow = 0 Then hdrRow = FindHeaderRow(wsD, "Equipment", 15)
    If hdrRow = 0 Then
        MsgBox "Cannot find 'Equipment' header in Distance.xlsx Sheet1.", vbExclamation
        GetARMGBlockList_FromDistance = ""
        Exit Function
    End If
    Dim colEquip As Long
    colEquip = FindColByHeader(wsD, hdrRow, "Equipment")
    If colEquip = 0 Then
        GetARMGBlockList_FromDistance = ""
        Exit Function
    End If
    Dim equipVal As String
    equipVal = CleanText(wsD.Cells(hdrRow + 1, colEquip).Value)
    If InStr(1, equipVal, "Armg", vbTextCompare) = 0 Then
        MsgBox "Expected 'Armg' in Distance.xlsx at row " & (hdrRow + 1) & _
               ", column " & colEquip & " but found: '" & equipVal & "'." & vbCrLf & _
               "Layout may have changed - please check Distance.xlsx.", vbExclamation
        GetARMGBlockList_FromDistance = ""
        Exit Function
    End If
    Dim blockCols(0 To 2) As Long
    Dim distCols(0 To 2) As Long
    blockCols(0) = colEquip + 1: distCols(0) = colEquip + 2   ' P4
    blockCols(1) = colEquip + 3: distCols(1) = colEquip + 4   ' P5
    blockCols(2) = colEquip + 5: distCols(2) = colEquip + 6   ' P6
    Dim bc As Long
    For bc = 0 To 2
        If LCase$(CleanText(wsD.Cells(hdrRow, blockCols(bc)).Value)) <> "block" Then
            MsgBox "Expected 'Block' header at column " & blockCols(bc) & _
                   " on row " & hdrRow & " - layout may have changed.", vbExclamation
            GetARMGBlockList_FromDistance = ""
            Exit Function
        End If
        If LCase$(CleanText(wsD.Cells(hdrRow, distCols(bc)).Value)) <> "distance" Then
            MsgBox "Expected 'Distance' header at column " & distCols(bc) & _
                   " on row " & hdrRow & " - layout may have changed.", vbExclamation
            GetARMGBlockList_FromDistance = ""
            Exit Function
        End If
    Next bc
    Dim r As Long
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = 1
    r = hdrRow + 1
    Do While Len(CleanText(wsD.Cells(r, blockCols(0)).Value)) > 0 _
           Or Len(CleanText(wsD.Cells(r, blockCols(1)).Value)) > 0 _
           Or Len(CleanText(wsD.Cells(r, blockCols(2)).Value)) > 0
        For bc = 0 To 2
            Dim bv As String
            Dim dv As Variant
            bv = CleanText(wsD.Cells(r, blockCols(bc)).Value)
            dv = wsD.Cells(r, distCols(bc)).Value
            If Len(bv) > 0 And IsNumeric(dv) Then
                If CDbl(dv) > RED_THRESHOLD Then
                    If Not dict.Exists(UCase$(bv)) Then dict.Add UCase$(bv), bv
                End If
            End If
        Next bc
        r = r + 1
    Loop
    Dim result As String, key As Variant
    For Each key In dict.Keys
        If Len(result) > 0 Then result = result & "|"
        result = result & dict(key)
    Next key
    GetARMGBlockList_FromDistance = result
End Function

