Private Sub AddValueFieldSafe( _
    ByVal pt As PivotTable, _
    ByVal srcField As String, _
    ByVal caption As String, _
    ByVal numFormat As String)
    Dim pf As PivotField
    On Error Resume Next
    Set pf = pt.PivotFields(srcField)
    On Error GoTo 0
    If pf Is Nothing Then Exit Sub
    HidePivotFieldSafe pt, srcField
    On Error Resume Next
    pf.Orientation = xlDataField
    pf.caption = caption
    pf.NumberFormat = numFormat
    On Error GoTo 0
End Sub

Private Sub HidePivotFieldSafe( _
    ByVal pt As PivotTable, _
    ByVal fieldName As String)
    Dim pf As PivotField
    On Error Resume Next
    Set pf = pt.PivotFields(fieldName)
    If Not pf Is Nothing Then pf.Orientation = xlHidden
    On Error GoTo 0
End Sub

'========================================================
' FILTER: PPT4 + PPT5 ONLY, TUAS HIDDEN
'========================================================
Private Sub FilterPivot_PPT4_PPT5_ExplicitNoTuas(ByVal pt As PivotTable)
    Dim pf  As PivotField
    Dim pi  As PivotItem
    Dim allowedItems As Variant
    Dim a As Long
    Dim isAllowed As Boolean
    allowedItems = Array("PPT4", "PPT5")

    On Error Resume Next
    Set pf = pt.PivotFields("vsl2_bthTerm")
    On Error GoTo 0
    If pf Is Nothing Then
        MsgBox "Field 'vsl2_bthTerm' not found in pivot table.", vbExclamation
        Exit Sub
    End If

    If pf.Orientation = xlPageField Then
        On Error Resume Next
        pf.CurrentPage = "(All)"
        On Error GoTo 0
    End If

    pt.ManualUpdate = True
    pf.EnableMultiplePageItems = True

    For Each pi In pf.PivotItems
        On Error Resume Next
        pi.Visible = True
        On Error GoTo 0
    Next pi

    For Each pi In pf.PivotItems
        isAllowed = False
        For a = LBound(allowedItems) To UBound(allowedItems)
            If StrComp(pi.Name, CStr(allowedItems(a)), vbTextCompare) = 0 Then
                isAllowed = True
                Exit For
            End If
        Next a
        If Not isAllowed Then
            On Error Resume Next
            pi.Visible = False
            On Error GoTo 0
        End If
    Next pi

    On Error Resume Next
    pf.PivotItems("Tuas").Visible = False
    On Error GoTo 0

    pt.ManualUpdate = False
End Sub

Private Sub FilterPivot_Berth_P1_To_P41(ByVal pt As PivotTable)
