Private Function IsInArray(ByVal needle As String, ByVal haystack As Variant) As Boolean
    Dim k As Long
    For k = LBound(haystack) To UBound(haystack)
        If StrComp(needle, CStr(haystack(k)), vbTextCompare) = 0 Then
            IsInArray = True
            Exit Function
        End If
    Next k
    IsInArray = False
End Function

Private Function RowQualifiesOverstow(ByVal wsFinal As Worksheet, ByVal i As Long, ByVal lastCol As Long) As Boolean
    Dim j As Long, headerText As String, cellVal As Variant
    For j = 1 To lastCol
        headerText = LCase$(Trim$(CStr(wsFinal.Cells(1, j).Value)))
        Select Case headerText
            Case "%overstow", "%overstow_inclr", "%overstow_outclr", _
                 "load overstow", "portmark overstow", "mix weight overstow"
                cellVal = wsFinal.Cells(i, j).Value
                If IsNumeric(cellVal) Then
                    If CDbl(cellVal) > 0 Then RowQualifiesOverstow = True: Exit Function
                ElseIf Len(Trim$(CStr(cellVal))) > 0 Then
                    RowQualifiesOverstow = True: Exit Function
                End If
        End Select
    Next j
    RowQualifiesOverstow = False
End Function

Private Function CleanText(ByVal v As Variant) As String
    Dim s As String
    s = CStr(v)
    s = Replace(s, Chr(160), " ")
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    CleanText = Trim$(s)
End Function

Private Sub ForceValuesToColumns(ByVal pt As PivotTable)
    Dim pf As PivotField
    On Error Resume Next
    Set pf = pt.DataPivotField
    On Error GoTo 0
    If pf Is Nothing Then Exit Sub
    pf.Orientation = xlColumnField
    pf.Position = 1
End Sub

Private Function FindHeaderRow(ByVal ws As Worksheet, ByVal token As String, Optional ByVal maxRows As Long = 120) As Long
    Dim r As Long, c As Range
    For r = 1 To maxRows
        Set c = ws.Rows(r).Find(What:=token, LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
        If Not c Is Nothing Then
            FindHeaderRow = r
            Exit Function
        End If
    Next r
    FindHeaderRow = 0
End Function

Private Function FindHeaderRowExact(ByVal ws As Worksheet, ByVal token As String, Optional ByVal maxRows As Long = 120) As Long
    Dim r As Long, c As Range
    For r = 1 To maxRows
        Set c = ws.Rows(r).Find(What:=token, LookIn:=xlValues, LookAt:=xlWhole, MatchCase:=False)
        If Not c Is Nothing Then
            FindHeaderRowExact = r
            Exit Function
        End If
    Next r
    FindHeaderRowExact = 0
End Function

Private Function FindColByHeader(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    Dim target As String, cur As String
    target = CleanText(headerText)
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then lastCol = 1
    For c = 1 To lastCol
        cur = CleanText(ws.Cells(headerRow, c).Value)
        If StrComp(cur, target, vbTextCompare) = 0 Then
            FindColByHeader = c
            Exit Function
        End If
    Next c
    FindColByHeader = 0
End Function

Private Function FindColAny(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal names As Variant) As Long
    Dim i As Long, col As Long
    For i = LBound(names) To UBound(names)
        col = FindColByHeader(ws, headerRow, CStr(names(i)))
        If col > 0 Then
            FindColAny = col
            Exit Function
        End If
    Next i
    FindColAny = 0
End Function

Private Function LastDataRow(ByVal ws As Worksheet, ByVal keyCol As Long, ByVal headerRow As Long) As Long
    Dim r As Long
    r = ws.Cells(ws.Rows.Count, keyCol).End(xlUp).Row
    If r < headerRow + 1 Then r = headerRow + 1
    LastDataRow = r
End Function

Private Function FindColumnContains(ws As Worksheet, txt As String, Optional maxRows As Long = 30) As Long
    Dim r As Long, f As Range
    For r = 1 To maxRows
        Set f = ws.Rows(r).Find(What:=txt, LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
        If Not f Is Nothing Then
            FindColumnContains = f.Column
            Exit Function
        End If
    Next r
    FindColumnContains = 0
End Function

Private Function FindColumnContainsRow(ws As Worksheet, txt As String, Optional maxRows As Long = 50) As Long
    Dim r As Long, f As Range
    For r = 1 To maxRows
        Set f = ws.Rows(r).Find(What:=txt, LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
        If Not f Is Nothing Then
            FindColumnContainsRow = f.Row
            Exit Function
        End If
    Next r
    FindColumnContainsRow = 0
End Function

