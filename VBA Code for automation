' DEBUG: paste into the module and run it (F5), or copy the
' single-line versions into the Immediate Window (Ctrl+G).
' This will show:
'   1) How many PivotTable objects exist on the Self_Service sheet
'   2) The name and field list of each one
' Run this BEFORE running Setup_SelfService_Pivot again.
'============================================================
Public Sub Setup_SelfService_Pivot_DEBUG()
    Dim wbSS As Workbook
    Set wbSS = GetSelfServiceWb(ThisWorkbook.Path)
    If wbSS Is Nothing Then
        MsgBox "Cannot find/open Self_Service.xlsx/.xlsm.", vbExclamation
        Exit Sub
    End If
 
    Dim wsSS As Worksheet
    On Error Resume Next
    Set wsSS = wbSS.Worksheets("Self_Service")
    On Error GoTo 0
    If wsSS Is Nothing Then
        MsgBox "Sheet 'Self_Service' not found.", vbExclamation
        Exit Sub
    End If
 
    Dim ptSS As PivotTable
    Set ptSS = wsSS.PivotTables(1)   ' confirmed = 'PivotTable2', the only one
 
    ptSS.ManualUpdate = True
 
    ' --- Step 1: hide unrelated fields (report but don't stop on error) ---
    Dim pf As PivotField
    Dim wantedFields As Variant, i As Long, isWanted As Boolean
    wantedFields = Array("Slot", "Terminal_ID", "CT", "ETB2", "ETU2", "Vsl_Voy2", "Block", "Cntr_N")
 
    For Each pf In ptSS.PivotFields
        isWanted = False
        For i = LBound(wantedFields) To UBound(wantedFields)
            If StrComp(pf.Name, CStr(wantedFields(i)), vbTextCompare) = 0 Then
                isWanted = True: Exit For
            End If
        Next i
        If Not isWanted Then
            On Error Resume Next
            pf.Orientation = xlHidden
            If Err.Number <> 0 Then
                MsgBox "Step1 hide '" & pf.Name & "' failed: " & Err.Number & " - " & Err.Description, vbExclamation
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next pf
 
    ' --- Step 2: Filters ---
    On Error Resume Next
    Err.Clear
    ptSS.PivotFields("Slot").Orientation = xlPageField
    If Err.Number <> 0 Then MsgBox "Slot->PageField failed: " & Err.Description: Err.Clear
    ptSS.PivotFields("Slot").Position = 1
    If Err.Number <> 0 Then MsgBox "Slot position failed: " & Err.Description: Err.Clear
 
    ptSS.PivotFields("Terminal_ID").Orientation = xlPageField
    If Err.Number <> 0 Then MsgBox "Terminal_ID->PageField failed: " & Err.Description: Err.Clear
    ptSS.PivotFields("Terminal_ID").Position = 2
    If Err.Number <> 0 Then MsgBox "Terminal_ID position failed: " & Err.Description: Err.Clear
 
    ptSS.PivotFields("CT").Orientation = xlPageField
    If Err.Number <> 0 Then MsgBox "CT->PageField failed: " & Err.Description: Err.Clear
    ptSS.PivotFields("CT").Position = 3
    If Err.Number <> 0 Then MsgBox "CT position failed: " & Err.Description: Err.Clear
    On Error GoTo 0
 
    ' --- Step 3: Rows ---
    On Error Resume Next
    Err.Clear
    ptSS.PivotFields("ETB2").Orientation = xlRowField
    If Err.Number <> 0 Then MsgBox "ETB2->RowField failed: " & Err.Number & " - " & Err.Description: Err.Clear
    ptSS.PivotFields("ETB2").Position = 1
    If Err.Number <> 0 Then MsgBox "ETB2 position failed: " & Err.Description: Err.Clear
 
    ptSS.PivotFields("ETU2").Orientation = xlRowField
    If Err.Number <> 0 Then MsgBox "ETU2->RowField failed: " & Err.Number & " - " & Err.Description: Err.Clear
    ptSS.PivotFields("ETU2").Position = 2
    If Err.Number <> 0 Then MsgBox "ETU2 position failed: " & Err.Description: Err.Clear
 
    ptSS.PivotFields("Vsl_Voy2").Orientation = xlRowField
    If Err.Number <> 0 Then MsgBox "Vsl_Voy2->RowField failed: " & Err.Number & " - " & Err.Description: Err.Clear
    ptSS.PivotFields("Vsl_Voy2").Position = 3
    If Err.Number <> 0 Then MsgBox "Vsl_Voy2 position failed: " & Err.Description: Err.Clear
    On Error GoTo 0
 
    ' --- Step 4: Columns ---
    On Error Resume Next
    Err.Clear
    ptSS.PivotFields("Block").Orientation = xlColumnField
    If Err.Number <> 0 Then MsgBox "Block->ColumnField failed: " & Err.Number & " - " & Err.Description: Err.Clear
    ptSS.PivotFields("Block").Position = 1
    If Err.Number <> 0 Then MsgBox "Block position failed: " & Err.Description: Err.Clear
    On Error GoTo 0
 
    ' --- Step 5: Values ---
    On Error Resume Next
    Err.Clear
    Dim pfData As PivotField
    Set pfData = ptSS.PivotFields("Cntr_N")
    If Err.Number <> 0 Then MsgBox "Getting Cntr_N field failed: " & Err.Number & " - " & Err.Description: Err.Clear
    pfData.Orientation = xlDataField
    If Err.Number <> 0 Then MsgBox "Cntr_N->DataField failed: " & Err.Number & " - " & Err.Description: Err.Clear
    pfData.Function = xlCount
    If Err.Number <> 0 Then MsgBox "Cntr_N Function=Count failed: " & Err.Number & " - " & Err.Description: Err.Clear
    pfData.caption = "Count of Cntr_N"
    If Err.Number <> 0 Then MsgBox "Cntr_N caption failed: " & Err.Number & " - " & Err.Description: Err.Clear
    On Error GoTo 0
 
    ptSS.ManualUpdate = False
 
    MsgBox "Done - check the Fields panel now.", vbInformation
End Sub
 
 
 
 
