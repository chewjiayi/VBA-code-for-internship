'========================================================
' MAIN 2: BUILD FINAL SHEET
'========================================================
Private Sub Build_FINAL_Smart_LOOKUP(ByVal filterStr As String, _
                                      Optional ByVal hasDateFilter As Boolean = False, _
                                      Optional ByVal dateFrom As Date = 0, _
                                      Optional ByVal dateTo As Date = 0)

    Dim folderPath As String
    folderPath = ThisWorkbook.Path

    '--- 1. VESSEL WORKBOOK ---
    Dim wbV As Workbook
    Dim wsV As Worksheet
    Set wbV = GetVesselWorkbookSmart(folderPath)
    If wbV Is Nothing Then
        MsgBox "Cannot find/open the vessel report file.", vbExclamation
        Exit Sub
    End If
    Dim sh As Worksheet
    For Each sh In wbV.Worksheets
        If SheetLooksLikeVessel(sh) Then Set wsV = sh: Exit For
    Next sh
    If wsV Is Nothing Then
        MsgBox "Found workbook but cannot locate the vessel sheet.", vbExclamation
        Exit Sub
    End If

    '--- 2. YARD BUILDUP QUALITY WORKBOOK ---
    Dim wbY As Workbook
    Dim wsY As Worksheet
    Set wbY = GetWbByNamePart("Yard_Buildup_Quality")
    If wbY Is Nothing Then
        Set wbY = OpenLatestFile(folderPath, "Yard_Buildup_Quality*.xlsm")
        If wbY Is Nothing Then Set wbY = OpenLatestFile(folderPath, "Yard_Buildup_Quality*.xlsx")
    End If
    If wbY Is Nothing Then
        MsgBox "Cannot find Yard_Buildup_Quality in folder: " & folderPath, vbExclamation
        Exit Sub
    End If
    Dim wsYFound As Boolean: wsYFound = False
    Dim shY As Worksheet
    For Each shY In wbY.Worksheets
        If LCase$(shY.Name) = "cluster_quality" Then
            Set wsY = shY: wsYFound = True: Exit For
        End If
    Next shY
    If Not wsYFound Then
        For Each shY In wbY.Worksheets
            If FindHeaderRow(shY, "%Overstow_inClr", 30) > 0 Then
                Set wsY = shY: wsYFound = True: Exit For
            End If
        Next shY
    End If
    If Not wsYFound Then Set wsY = wbY.ActiveSheet

    '--- 3. LOAD_VESSEL_LIST WORKBOOK ---
    Dim wbL As Workbook
    Set wbL = GetLoadVesselListWb(folderPath)
    Dim dictLoad As Object
    If wbL Is Nothing Then
        MsgBox "WARNING: Load_Vessel_List file not found." & vbCrLf & _
               "LOAD / PORTMARK / MIX WEIGHT OVERSTOW columns will be blank." & vbCrLf & _
               "Continuing with other data...", vbExclamation
        Set dictLoad = CreateObject("Scripting.Dictionary")
        dictLoad.CompareMode = 1
    Else
        Set dictLoad = BuildLoadVesselDict(wbL)
        If dictLoad.Count = 0 Then
            MsgBox "WARNING: Load_Vessel_List opened but no data could be read." & vbCrLf & _
                   "Check that the sheet contains VSL and OVERSTOW columns.", vbExclamation
        End If
    End If

    '--- 4. SERVICING WORKBOOK (optional) ---
    Dim wbS As Workbook
    Dim wsS As Worksheet
    Set wbS = GetServicingWb(folderPath)
    If Not wbS Is Nothing Then Set wsS = GetServicingSheet(wbS)

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    On Error GoTo FailSafe

    '--- Vessel column indices ---
    Dim hdrV As Long, dataStartV As Long, lastRowV As Long
    Dim colVSL_V As Long, colTRMNL As Long, colBTH   As Long
    Dim colETB_V As Long, colETU_V As Long
    Dim colDecl  As Long, colDisc  As Long, colLoad  As Long
    Dim colDeclLR As Long, colActLR As Long

    hdrV = FindHeaderRow(wsV, "TRMNL", 150)
    If hdrV = 0 Then hdrV = FindHeaderRow(wsV, "VSL", 150)
    If hdrV = 0 Then Err.Raise vbObjectError + 1, , "Cannot find vessel header row."
    dataStartV = hdrV + 1

    colVSL_V = FindColAny(wsV, hdrV, Array("VSL / OUTVOY", "VSL / OUT LINE", "VSL"))
    colTRMNL = FindColByHeader(wsV, hdrV, "TRMNL")
    colBTH = FindColByHeader(wsV, hdrV, "BTH")
    colETB_V = FindColAny(wsV, hdrV, Array("ETB", "ETB2"))
    colETU_V = FindColAny(wsV, hdrV, Array("ETU", "ETU2"))
    colDecl = FindColAny(wsV, hdrV, Array("Declared (Ctrs)", "Declared"))
    colDisc = FindColAny(wsV, hdrV, Array("Disc(Ctrs)", "Disc (Ctrs)"))
    colLoad = FindColAny(wsV, hdrV, Array("Load (Ctrs)", "Load"))
    colDeclLR = FindColAny(wsV, hdrV, Array("Declared L&R (Ctrs)", "Declared L", "Declared L&R"))
    colActLR = FindColAny(wsV, hdrV, Array("Actual L&R (Ctrs)", "Actual L&R", "Actual"))

    If colVSL_V = 0 Or colTRMNL = 0 Or colBTH = 0 Or colETB_V = 0 Then
        Err.Raise vbObjectError + 2, , "Missing required vessel columns (VSL, TRMNL, BTH or ETB)."
    End If
    lastRowV = LastDataRow(wsV, colVSL_V, hdrV)

    '--- Yard column indices ---
    Dim hdrY As Long, hdrY_top As Long, dataStartY As Long, lastRowY As Long
    Dim colVSL_Y As Long, colBTH_Y As Long
    Dim colInY   As Long, colOutY  As Long, colTotY As Long

    hdrY = FindHeaderRowExact(wsY, "berth", 150)
    If hdrY = 0 Then hdrY = FindHeaderRowExact(wsY, "ETB", 150)
    If hdrY = 0 Then hdrY = FindHeaderRowExact(wsY, "Vsl", 150)
    If hdrY = 0 Then Err.Raise vbObjectError + 3, , "Cannot find Yard header row (berth/ETB/Vsl)."

    hdrY_top = hdrY - 1
    If hdrY_top < 1 Then hdrY_top = hdrY
    dataStartY = hdrY + 1

    colTotY = FindColAny(wsY, hdrY_top, Array("%Overs", "%Overstow", "%Overstow_inClr"))
    colInY = FindColAny(wsY, hdrY_top, Array("Overstow_in", "%Overstow_inClr"))
    colOutY = FindColAny(wsY, hdrY_top, Array("Overstow_out", "%Overstow_outClr"))
    colVSL_Y = FindColAny(wsY, hdrY, Array("Vsl", "VSL / OUTVOY", "Vsl_Voy2", "Vsl_Voy", "VSL", "Vessel"))
    colBTH_Y = FindColAny(wsY, hdrY, Array("berth", "BTH", "Berth"))

    If colInY = 0 Or colOutY = 0 Or colTotY = 0 Or colVSL_Y = 0 Then
        Err.Raise vbObjectError + 4, , "Yard sheet missing Vsl or %Overstow columns." & vbCrLf & _
            "colTotY=" & colTotY & " colInY=" & colInY & _
            " colOutY=" & colOutY & " colVSL_Y=" & colVSL_Y & vbCrLf & _
            "hdrY=" & hdrY & " hdrY_top=" & hdrY_top
    End If
    If colBTH_Y = 0 Then
        MsgBox "WARNING: Yard 'berth' column not found. Matching by vessel name only.", vbExclamation
    End If
    lastRowY = LastDataRow(wsY, colVSL_Y, hdrY)

    '--- Build Yard lookup dictionary ---
    Dim dictYard As Object: Set dictYard = CreateObject("Scripting.Dictionary")
    dictYard.CompareMode = 1
    Dim ry As Long, k As String
    Dim vslYBase As String
    Dim lastBerthY As String: lastBerthY = ""
    Dim arrVal As Variant

    For ry = dataStartY To lastRowY
        Dim rawBerthY As String
        If colBTH_Y > 0 Then
            rawBerthY = UCase$(Trim$(CleanText(wsY.Cells(ry, colBTH_Y).Value)))
            If Len(rawBerthY) > 0 And rawBerthY <> "GRAND TOTAL" Then lastBerthY = rawBerthY
        End If
        Dim rawVslY As String
        rawVslY = CleanText(wsY.Cells(ry, colVSL_Y).Value)
        If Len(rawVslY) = 0 Then GoTo NextYardRow
        If UCase$(rawVslY) = "GRAND TOTAL" Then GoTo NextYardRow
        vslYBase = UCase$(Trim$(rawVslY))
        arrVal = Array( _
            NormalizePct(wsY.Cells(ry, colInY).Value), _
            NormalizePct(wsY.Cells(ry, colOutY).Value), _
            NormalizePct(wsY.Cells(ry, colTotY).Value))
        If Len(lastBerthY) > 0 Then
            k = lastBerthY & "|" & vslYBase
            If Not dictYard.Exists(k) Then dictYard.Add k, arrVal
        End If
        If Not dictYard.Exists(vslYBase) Then dictYard.Add vslYBase, arrVal
NextYardRow:
    Next ry

    '--- Create / clear FINAL sheet ---
    Dim wsOut As Worksheet
    On Error Resume Next
    Set wsOut = wbV.Worksheets("FINAL")
    On Error GoTo FailSafe
    If wsOut Is Nothing Then
        Set wsOut = wbV.Worksheets.Add(After:=wbV.Worksheets(wbV.Worksheets.Count))
        wsOut.Name = "FINAL"
    Else
        wsOut.Cells.Clear
    End If

    '--- Write headers ---
    Dim headersVessel As Variant, headersOver As Variant, headersBlank As Variant
    headersVessel = Array("VSL / OUTVOY", "TRMNL", "BTH", "ETB", "ETU", _
                          "Declared (Ctrs)", "Disc(Ctrs)", "Load (Ctrs)", _
                          "Declared L&R (Ctrs)", "Actual L&R (Ctrs)")
    headersOver = Array("%Overstow_inClr", "%Overstow_outClr", "%Overstow")
    headersBlank = Array("LOAD OVERSTOW", "PORTMARK OVERSTOW", "MIX WEIGHT OVERSTOW", _
                          "IYS PG", "Cntrs raised (YP to update)", _
                          "Shifting progress", "YP remarks", "SP Remarks")

    Dim oc As Long: oc = 1
    Dim i As Long
    For i = LBound(headersVessel) To UBound(headersVessel)
        wsOut.Cells(1, oc).Value = headersVessel(i): oc = oc + 1
    Next i
    For i = LBound(headersOver) To UBound(headersOver)
        wsOut.Cells(1, oc).Value = headersOver(i): oc = oc + 1
    Next i
    For i = LBound(headersBlank) To UBound(headersBlank)
        wsOut.Cells(1, oc).Value = headersBlank(i): oc = oc + 1
    Next i
    wsOut.Rows(1).Font.Bold = True

    Const overColStart As Long = 11

    '--- Fill FINAL rows ---
    Dim outRow As Long: outRow = 2
    Dim rv As Long
    Dim arrO As Variant, arrL As Variant
    Dim foundYard As Boolean, foundLoad As Boolean
    Dim vslV As String, vslVBase As String, vslVKey As String
    Dim bthV As String, trm As String, bth As String
    Dim matchedYard As Long: matchedYard = 0
    Dim matchedLoad As Long: matchedLoad = 0
    Dim unmatchedList As String

    For rv = dataStartV To lastRowV
        vslV = CleanText(wsV.Cells(rv, colVSL_V).Value)
        If Len(vslV) = 0 Then GoTo NextV
        trm = CleanText(wsV.Cells(rv, colTRMNL).Value)
        bth = CleanText(wsV.Cells(rv, colBTH).Value)
        If Not IsAllowedTRMNL(trm) Then GoTo NextV
        If IsBadBTH(bth, "BTK") Then GoTo NextV

        '=== MULTI-VESSEL FILTER ===
        If Not MatchesAnyVessel(vslV, filterStr) Then GoTo NextV
        '===========================
        ' NOTE: the FINAL sheet (Table 1 / vessel cards) is intentionally NOT
        ' date-filtered - the date filter only applies to the Long Haul (aRMG)
        ' table further down in the email.

        vslVBase = VslBaseName(vslV)
        vslVKey = UCase$(Trim$(vslVBase))
        bthV = UCase$(Trim$(bth))

        wsOut.Cells(outRow, 1).Value = wsV.Cells(rv, colVSL_V).Value
        wsOut.Cells(outRow, 2).Value = wsV.Cells(rv, colTRMNL).Value
        wsOut.Cells(outRow, 3).Value = wsV.Cells(rv, colBTH).Value
        wsOut.Cells(outRow, 4).Value = wsV.Cells(rv, colETB_V).Value
        If colETU_V > 0 Then wsOut.Cells(outRow, 5).Value = wsV.Cells(rv, colETU_V).Value
        If colDecl > 0 Then wsOut.Cells(outRow, 6).Value = wsV.Cells(rv, colDecl).Value
        If colDisc > 0 Then wsOut.Cells(outRow, 7).Value = wsV.Cells(rv, colDisc).Value
        If colLoad > 0 Then wsOut.Cells(outRow, 8).Value = wsV.Cells(rv, colLoad).Value
        If colDeclLR > 0 Then wsOut.Cells(outRow, 9).Value = wsV.Cells(rv, colDeclLR).Value
        If colActLR > 0 Then wsOut.Cells(outRow, 10).Value = wsV.Cells(rv, colActLR).Value

        foundYard = False
        If Len(bthV) > 0 Then
            k = bthV & "|" & vslVKey
            If dictYard.Exists(k) Then arrO = dictYard(k): foundYard = True
        End If
        If Not foundYard Then
            If dictYard.Exists(vslVKey) Then arrO = dictYard(vslVKey): foundYard = True
        End If
        If foundYard Then
            wsOut.Cells(outRow, overColStart).Value = arrO(0)
            wsOut.Cells(outRow, overColStart + 1).Value = arrO(1)
            wsOut.Cells(outRow, overColStart + 2).Value = arrO(2)
            matchedYard = matchedYard + 1
        Else
            If Len(unmatchedList) < 3000 Then
                unmatchedList = unmatchedList & "YARD: " & bthV & "  " & vslV & vbCrLf
            End If
        End If

        foundLoad = False
        If dictLoad.Exists(vslVKey) Then arrL = dictLoad(vslVKey): foundLoad = True
        If foundLoad Then
            wsOut.Cells(outRow, overColStart + 3).Value = arrL(0)
            wsOut.Cells(outRow, overColStart + 4).Value = arrL(1)
            wsOut.Cells(outRow, overColStart + 5).Value = arrL(2)
            matchedLoad = matchedLoad + 1
        Else
            If Len(unmatchedList) < 3000 Then
                unmatchedList = unmatchedList & "LOAD: " & vslV & vbCrLf
            End If
        End If

        outRow = outRow + 1
NextV:
    Next rv

    If outRow > 2 Then
        wsOut.Range(wsOut.Cells(2, overColStart), wsOut.Cells(outRow - 1, overColStart + 2)).NumberFormat = "0.00%"
        wsOut.Range(wsOut.Cells(2, 4), wsOut.Cells(outRow - 1, 4)).NumberFormat = "d/m/yyyy h:mm"
        wsOut.Range(wsOut.Cells(2, 5), wsOut.Cells(outRow - 1, 5)).NumberFormat = "d/m/yyyy h:mm"
    End If
    wsOut.Columns.AutoFit
    wsOut.Range("A1").AutoFilter

    Dim loadWbName As String: loadWbName = IIf(wbL Is Nothing, "(not found)", wbL.Name)
    Dim svcWbName  As String: svcWbName = IIf(wbS Is Nothing, "(not found)", wbS.Name)

    Dim filterNote As String
    If Len(filterStr) > 0 Then
        filterNote = "Vessel filter(s)   : " & Replace(filterStr, "|", ", ") & vbCrLf
    End If
    If hasDateFilter Then
        filterNote = filterNote & "Date filter (Long Haul table only) : " & _
                     DateFilterDisplayText(hasDateFilter, dateFrom, dateTo) & vbCrLf
    End If

    Dim summary As String
    summary = "FINAL sheet built in  : " & wbV.Name & vbCrLf & _
              filterNote & _
              "Load_Vessel_List file : " & loadWbName & vbCrLf & _
              "Servicing file        : " & svcWbName & vbCrLf & _
              "Load dict entries     : " & dictLoad.Count & vbCrLf & _
              "Total rows output     : " & (outRow - 2) & vbCrLf & _
              "Yard matches          : " & matchedYard & vbCrLf & _
              "Load_VSL matches      : " & matchedLoad & vbCrLf & _
              "Yard dict entries     : " & dictYard.Count
    If Len(unmatchedList) > 0 Then
        summary = summary & vbCrLf & vbCrLf & "--- Unmatched rows ---" & vbCrLf & unmatchedList
    End If
    MsgBox summary, vbInformation, "Build FINAL - Complete"

CleanExit:
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Exit Sub
FailSafe:
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    MsgBox "Error " & Err.Number & ": " & Err.Description, vbExclamation, "Build FINAL - Error"
End Sub

'========================================================
' MAIN 3: SEND EMAIL
'========================================================
Private Sub Macro_Send_Email_PSA( _
    ByVal wsSvcDirect As Worksheet, _
    ByVal filterStr As String, _
    Optional ByVal hasDateFilter As Boolean = False, _
    Optional ByVal dateFrom As Date = 0, _
    Optional ByVal dateTo As Date = 0, _
    Optional ByVal runLoadVessel As Boolean = True, _
    Optional ByVal runSelfService As Boolean = True, _
    Optional ByVal runLongHaul As Boolean = True, _
    Optional ByVal ssHasDateFilter As Boolean = False, _
    Optional ByVal ssDateFrom As Date = 0, _
    Optional ByVal ssDateTo As Date = 0, _
    Optional ByVal ssBlockFilterStr As String = "")

    Dim eApp As Object
    Dim eItem As Object
    Dim wsFinal As Worksheet
    Dim lastCol As Long
    Dim i As Long, j As Long
    Dim htmlBody As String
    Dim cellVal As Variant
    Dim formattedVal As String
    Dim headerText As String
    Dim hasOverstowValue As Boolean
    Dim toAddr As String
    Dim x As Double
    Dim blueHeaders As Variant
    Dim hdrVal As String
    Dim hdrLower As String
    Dim isBlueCol As Boolean
    Dim b As Long
    Dim mainLastRow As Long

    On Error Resume Next
    Set eApp = GetObject(, "Outlook.Application")
    If eApp Is Nothing Then Set eApp = CreateObject("Outlook.Application")
    On Error GoTo 0
    Set eItem = eApp.CreateItem(0)

    Set wsFinal = Nothing
    If runLoadVessel Then
        On Error Resume Next
        Set wsFinal = ActiveWorkbook.Worksheets("FINAL")
        On Error GoTo 0
        If wsFinal Is Nothing Then
            MsgBox "Sheet 'FINAL' not found in active workbook.", vbCritical
            Exit Sub
        End If
    End If

    '--- Servicing source ---
    Dim wsSvc As Worksheet
    Set wsSvc = wsSvcDirect   ' may be Nothing - that's fine

    blueHeaders = Array("%overstow_inclr", "%overstow_outclr", "%overstow", _
                        "load overstow", "portmark overstow", "mix weight overstow")

    Dim hiddenEmailCols As Variant
    hiddenEmailCols = Array("load overstow", "portmark overstow", "mix weight overstow")

    htmlBody = "<html><body style='font-family:Calibri;font-size:11pt;'>"

    htmlBody = htmlBody & "<p>Dear YP / SP team,</p>"
    htmlBody = htmlBody & "<p>Below are the critical vessels for the incoming shifts of the respective terminals.</p>"
    htmlBody = htmlBody & "<p>Kindly assist to review shifting out from upcoming servicing blocks and any advance overstows rectification for the priority vessels.</p>"

    If runLoadVessel Then

    mainLastRow = wsFinal.Cells(wsFinal.Rows.Count, 1).End(xlUp).Row
    lastCol = wsFinal.Cells(1, wsFinal.Columns.Count).End(xlToLeft).Column

    '=== VESSEL FOCUS CARDS ===
    htmlBody = htmlBody & BuildVesselCardsHtml(ThisWorkbook.Path, filterStr)
    htmlBody = htmlBody & "<div style='height:20px;'>&nbsp;</div>"

    '=== TABLE 1: MAIN OVERSTOW TABLE ===
    Dim colTRMNL As Long
    colTRMNL = FindColByHeader(wsFinal, 1, "TRMNL")

    '--- Group rows by terminal: PPT4 (TRMNL = P4SE) then PPT56 (TRMNL = P56SE) ---
    Dim termGroups As Variant, termLabels As Variant, g As Long
    termGroups = Array("PPT4", "P56SE")
    termLabels = Array("PPT4", "PPT56")

    For g = LBound(termGroups) To UBound(termGroups)
        Dim groupHasRows As Boolean
        groupHasRows = False
        If colTRMNL > 0 Then
            For i = 2 To mainLastRow
                If StrComp(Trim$(CStr(wsFinal.Cells(i, colTRMNL).Value)), CStr(termGroups(g)), vbTextCompare) = 0 Then
                    If RowQualifiesOverstow(wsFinal, i, lastCol) Then
                        groupHasRows = True
                        Exit For
                    End If
                End If
            Next i
        End If

        If groupHasRows Then
            '--- Heading above this group's table ---
            htmlBody = htmlBody & "<span style='display:block;font-family:Calibri;font-size:11pt;font-weight:bold;color:#1F3864;margin-top:20px;margin-bottom:6px;'>" & _
                       HtmlEncode(CStr(termLabels(g))) & "</span>"

            '--- This group's own table ---
            htmlBody = htmlBody & "<table border='1' cellpadding='8' width=100% cellspacing='0' style='border-collapse:collapse;" & _
                       "font-family:Calibri;font-size:10.5pt;margin-top:8px;'>"

            htmlBody = htmlBody & "<tr style='background-color:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;'>"
            For j = 1 To lastCol
                hdrVal = CStr(wsFinal.Cells(1, j).Value)
                If Not IsInArray(LCase$(Trim$(hdrVal)), hiddenEmailCols) Then
                    htmlBody = htmlBody & "<th>" & HtmlEncode(hdrVal) & "</th>"
                End If
            Next j
            htmlBody = htmlBody & "</tr>"

            For i = 2 To mainLastRow
                If StrComp(Trim$(CStr(wsFinal.Cells(i, colTRMNL).Value)), CStr(termGroups(g)), vbTextCompare) <> 0 Then GoTo NextRowG
                If Not RowQualifiesOverstow(wsFinal, i, lastCol) Then GoTo NextRowG

                htmlBody = htmlBody & "<tr style='background-color:#F3E5F5;'>"
                For j = 1 To lastCol
                    cellVal = wsFinal.Cells(i, j).Value
                    headerText = LCase$(Trim$(CStr(wsFinal.Cells(1, j).Value)))
                    If IsInArray(headerText, hiddenEmailCols) Then GoTo NextCol
                    formattedVal = ""
                    Select Case headerText
                        Case "%overstow", "%overstow_inclr", "%overstow_outclr"
                            If Trim$(CStr(cellVal)) <> "" And IsNumeric(cellVal) Then
                                x = CDbl(cellVal)
                                If x <= 1 Then
                                    formattedVal = Format(x, "0%")
                                ElseIf x <= 100 Then
                                    formattedVal = Format(x / 100#, "0.00%")
                                Else
                                    formattedVal = Format(x, "0.00%")
                                End If
                            End If
                            htmlBody = htmlBody & "<td align='center'>" & HtmlEncode(formattedVal) & "</td>"
                        Case Else
                            htmlBody = htmlBody & "<td>" & HtmlEncode(CStr(cellVal)) & "</td>"
                    End Select
NextCol:
                Next j
                htmlBody = htmlBody & "</tr>"
NextRowG:
            Next i

            htmlBody = htmlBody & "</table>"
        End If
    Next g

    '=== TABLE 2: SERVICING TABLE ===
    If Not wsSvc Is Nothing Then
        Dim hdrSvc As Long
        hdrSvc = FindHeaderRow(wsSvc, "Vsl_Voy2", 20)
        If hdrSvc = 0 Then hdrSvc = FindHeaderRow(wsSvc, "Block", 20)
        If hdrSvc = 0 Then hdrSvc = 1

        Dim colSvcVsl As Long
        colSvcVsl = FindColAny(wsSvc, hdrSvc, Array("Vsl_Voy2", "Vsl_Voy", "VSL", "Vessel"))

        Dim svcLastColE As Long
        Dim svcLastRowE As Long
        svcLastColE = wsSvc.Cells(hdrSvc, wsSvc.Columns.Count).End(xlToLeft).Column
        svcLastRowE = wsSvc.Cells(wsSvc.Rows.Count, 1).End(xlUp).Row

        Dim svcRows()   As Long
        Dim svcRowCount As Long
        svcRowCount = 0
        ReDim svcRows(1 To svcLastRowE)

        Dim iSvc As Long
        Dim hasFilter As Boolean
        hasFilter = (Len(filterStr) > 0)

        Dim dataCheckStartCol As Long
        dataCheckStartCol = colSvcVsl + 1
        If dataCheckStartCol < 1 Or dataCheckStartCol > svcLastColE Then dataCheckStartCol = 3

        For iSvc = hdrSvc + 1 To svcLastRowE
            Dim isTotalSvc As Boolean
            isTotalSvc = InStr(1, LCase$(CStr(wsSvc.Cells(iSvc, 1).Value)), "total", vbTextCompare) > 0

            If Not ServicingRowHasData(wsSvc, iSvc, dataCheckStartCol, svcLastColE) Then GoTo NextSvcRow

            If isTotalSvc Then
                svcRowCount = svcRowCount + 1
                svcRows(svcRowCount) = iSvc
            ElseIf hasFilter Then
                Dim rowMatchesSvc As Boolean
                rowMatchesSvc = False
                If colSvcVsl > 0 Then
                    rowMatchesSvc = MatchesAnyVessel( _
                        CleanText(wsSvc.Cells(iSvc, colSvcVsl).Value), filterStr)
                Else
                    Dim jSvc As Long
                    For jSvc = 1 To svcLastColE
                        If MatchesAnyVessel(CStr(wsSvc.Cells(iSvc, jSvc).Value), filterStr) Then
                            rowMatchesSvc = True: Exit For
                        End If
                    Next jSvc
                End If
                If rowMatchesSvc Then
                    svcRowCount = svcRowCount + 1
                    svcRows(svcRowCount) = iSvc
                End If
            Else
                svcRowCount = svcRowCount + 1
                svcRows(svcRowCount) = iSvc
            End If
NextSvcRow:
        Next iSvc

        Dim hasActualSvc As Boolean
        Dim r As Long

        hasActualSvc = False

        For r = 1 To svcRowCount
            If InStr(1, UCase$(Trim$(CStr(wsSvc.Cells(svcRows(r), 1).Value))), "TOTAL") = 0 Then
                If Trim$(CStr(wsSvc.Cells(svcRows(r), colSvcVsl).Value)) <> "" Then
                    hasActualSvc = True
                    Exit For
                End If
            End If
        Next r

        If svcLastColE > 0 And hasActualSvc Then
            htmlBody = htmlBody & "<br><br><p><b>Servicing:</b></p>"
            htmlBody = htmlBody & "<table border='1' cellpadding='10' cellspacing='0' width='700' " & _
                       "style='border-collapse:collapse;'>"

            Dim jj As Long
            htmlBody = htmlBody & "<colgroup>"
            For jj = 1 To svcLastColE
                If jj = 1 Then
                    htmlBody = htmlBody & "<col width='100'>"
                ElseIf jj = 2 Then
                    htmlBody = htmlBody & "<col width='480'>"
                Else
                    htmlBody = htmlBody & "<col width='120'>"
                End If
            Next jj
            htmlBody = htmlBody & "</colgroup>"

            htmlBody = htmlBody & "<tr><td colspan='" & svcLastColE & "' width='700' " & _
                       "style='background-color:#FF8C00;color:#FFFFFF;font-weight:bold;" & _
                       "text-align:center;font-size:12pt;padding:10px;'>Servicing</td></tr>"

            htmlBody = htmlBody & "<tr style='font-size:1px;line-height:1px;'>"
            For jj = 1 To svcLastColE
                If jj = 1 Then
                    htmlBody = htmlBody & "<td width='100' style='padding:0;'>&nbsp;</td>"
                ElseIf jj = 2 Then
                    htmlBody = htmlBody & "<td width='480' style='padding:0;'>&nbsp;</td>"
                Else
                    htmlBody = htmlBody & "<td width='120' style='padding:0;'>&nbsp;</td>"
                End If
            Next jj
            htmlBody = htmlBody & "</tr>"

            htmlBody = htmlBody & "<tr style='background-color:#FFD580;font-weight:bold;'>"
            For jj = 1 To svcLastColE
                Dim hdrSvcVal As String
                hdrSvcVal = HtmlEncode(CStr(wsSvc.Cells(hdrSvc, jj).Value))
                If jj = 1 Then
                    htmlBody = htmlBody & "<th width='100' style='text-align:left;padding:10px;" & _
                               "white-space:nowrap;'>" & hdrSvcVal & "</th>"
                ElseIf jj = 2 Then
                    htmlBody = htmlBody & "<th width='480' style='text-align:left;padding:10px;" & _
                               "white-space:nowrap;'>" & hdrSvcVal & "</th>"
                Else
                    htmlBody = htmlBody & "<th width='120' style='text-align:center;padding:10px;" & _
                               "white-space:nowrap;'>" & hdrSvcVal & "</th>"
                End If
            Next jj
            htmlBody = htmlBody & "</tr>"

            Dim isTotalRowE As Boolean
            For r = 1 To svcRowCount
                Dim ii As Long
                ii = svcRows(r)
                Dim cellValE As String
                isTotalRowE = InStr(1, LCase$(CStr(wsSvc.Cells(ii, 1).Value)), "total", vbTextCompare) > 0
                If isTotalRowE Then
                    htmlBody = htmlBody & "<tr style='background-color:#FFD580;font-weight:bold;'>"
                Else
                    htmlBody = htmlBody & "<tr style='background-color:#FFF3E0;'>"
                End If
                For jj = 1 To svcLastColE
                    Dim svcCellE As Range
                    Set svcCellE = wsSvc.Cells(ii, jj)
                    If IsNumeric(svcCellE.Value) And svcCellE.Value > 0 And svcCellE.Value < 1 Then
                        cellValE = Format(svcCellE.Value, "HH:MM")
                    Else
                        cellValE = CStr(svcCellE.Value)
                    End If
                    Dim tdStyleE As String
                    Dim tdWidthE As String
                    If jj = 1 Then
                        tdStyleE = "text-align:left;white-space:nowrap;padding:10px;"
                        tdWidthE = "100"
                    ElseIf jj = 2 Then
                        tdStyleE = "text-align:left;white-space:nowrap;padding:10px;"
                        tdWidthE = "480"
                    Else
                        tdStyleE = "text-align:center;white-space:nowrap;padding:10px;"
                        tdWidthE = "120"
                    End If
                    If isTotalRowE Then
                        htmlBody = htmlBody & "<td width='" & tdWidthE & "' style='" & tdStyleE & "'><b>" & HtmlEncode(cellValE) & "</b></td>"
                    Else
                        htmlBody = htmlBody & "<td width='" & tdWidthE & "' style='" & tdStyleE & "'>" & HtmlEncode(cellValE) & "</td>"
                    End If
                Next jj
                htmlBody = htmlBody & "</tr>"
            Next r
            htmlBody = htmlBody & "</table>"
        End If
    End If

    End If ' runLoadVessel

    '=== LONG HAUL TABLE (red aRMG blocks) ===
    If runLongHaul Then
        htmlBody = htmlBody & BuildSelfServiceRedBlockHtml(ThisWorkbook.Path, filterStr, hasDateFilter, dateFrom, dateTo)
    End If

    '=== SELF SERVICE TABLE (PPT4 / P56SE) ===
    If runSelfService Then
        htmlBody = htmlBody & BuildSelfServicingHtml(ThisWorkbook.Path, filterStr, _
                                                       ssHasDateFilter, ssDateFrom, ssDateTo, ssBlockFilterStr)
    End If
    htmlBody = htmlBody & "<p>Regards,<br>Operations<br>Name</p></body></html>"

    toAddr = TO_ADDR_LIST
    With eItem
        .To = TO_ADDR_LIST
        .cc = CC_ADDR_LIST
        .Subject = "[P456] Incoming Shift Support for Critical & High Loading Vessels (" & _
                   Format(Now, "dd/mm") & " D/G shift)"
        .htmlBody = htmlBody
        .Display
    End With

    MsgBox "Email drafted successfully.", vbInformation, "Send Email"
End Sub
Private Sub FilterSelfService_PageField(ByVal pt As PivotTable, ByVal fieldName As String, ByVal allowedItems As Variant)
    Dim pf As PivotField, pi As PivotItem, a As Long, isAllowed As Boolean
 
    On Error Resume Next
    Set pf = pt.PivotFields(fieldName)
    On Error GoTo 0
    If pf Is Nothing Then Exit Sub
 
    On Error Resume Next
    pf.EnableMultiplePageItems = True
    On Error GoTo 0
 
    ' Show everything first so nothing stays hidden from a previous run
    For Each pi In pf.PivotItems
        On Error Resume Next
        pi.Visible = True
        On Error GoTo 0
    Next pi
 
    ' Now hide anything not in the allowed list
    For Each pi In pf.PivotItems
        isAllowed = False
        For a = LBound(allowedItems) To UBound(allowedItems)
            If StrComp(pi.Name, CStr(allowedItems(a)), vbTextCompare) = 0 Then
                isAllowed = True
                Exit For
            End If
        Next a
        If Not isAllowed Then
            On Error Resume Next
            pi.Visible = False
            On Error GoTo 0
        End If
    Next pi
End Sub
 
