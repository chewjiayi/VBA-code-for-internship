' MULTI-VESSEL FILTER HELPER
'========================================================
Private Function MatchesAnyVessel(ByVal cellText As String, ByVal filterStr As String) As Boolean
    If Len(filterStr) = 0 Then
        MatchesAnyVessel = True
        Exit Function
    End If
    Dim upper As String
    upper = UCase$(cellText)
    Dim tokens() As String
    tokens = Split(filterStr, "|")
    Dim i As Long
    For i = LBound(tokens) To UBound(tokens)
        If Len(tokens(i)) > 0 Then
            If InStr(1, upper, tokens(i), vbTextCompare) > 0 Then
                MatchesAnyVessel = True
                Exit Function
            End If
        End If
    Next i
    MatchesAnyVessel = False
End Function

'========================================================
' DATE FILTER HELPERS
'========================================================
' Parses a single "DD/MM/YYYY" token explicitly - does NOT rely on CDate,
' because CDate's interpretation of "7/4/2026" depends on the Windows
' regional settings of whoever runs the macro (could mean 7-Apr or 4-Jul).
' This always means day/month/year, no matter what PC runs it.
Private Function ParseDDMMYYYY(ByVal token As String, ByRef outDate As Date) As Boolean
    Dim s As String
    s = Trim$(token)

    Dim segs() As String
    segs = Split(s, "/")
    If UBound(segs) <> 2 Then
        segs = Split(s, "-")   ' allow DD-MM-YYYY too, just in case
    End If
    If UBound(segs) <> 2 Then
        ParseDDMMYYYY = False
        Exit Function
    End If

    If Not IsNumeric(segs(0)) Or Not IsNumeric(segs(1)) Or Not IsNumeric(segs(2)) Then
        ParseDDMMYYYY = False
        Exit Function
    End If

    Dim d As Long, m As Long, y As Long
    d = CLng(segs(0))
    m = CLng(segs(1))
    y = CLng(segs(2))
    If y < 100 Then y = y + 2000   ' e.g. "26" -> 2026

    If m < 1 Or m > 12 Or d < 1 Or d > 31 Or y < 1900 Or y > 2100 Then
        ParseDDMMYYYY = False
        Exit Function
    End If

    On Error Resume Next
    Err.Clear
    outDate = DateSerial(y, m, d)
    If Err.Number <> 0 Then
        ParseDDMMYYYY = False
        Exit Function
    End If
    On Error GoTo 0

    ' DateSerial silently rolls over invalid days (e.g. 31/04) into the next
    ' month - catch that instead of accepting a shifted date.
    If Month(outDate) <> m Or Day(outDate) <> d Or Year(outDate) <> y Then
        ParseDDMMYYYY = False
        Exit Function
    End If

    ParseDDMMYYYY = True
End Function

' Parses the user's raw InputBox text into a date filter. Dates are always
' read as DD/MM/YYYY, regardless of the PC's regional settings.
' Accepts:
'   ""                          -> no date filter (all dates)
'   "15/07/2026"                -> single date
'   "15/07/2026-20/07/2026"     -> date range (order doesn't matter)
' Returns False if the text could not be parsed as (a) valid date(s).
Private Function ParseDateFilterInput(ByVal rawInput As String, _
                                       ByRef hasDateFilter As Boolean, _
                                       ByRef dateFrom As Date, _
                                       ByRef dateTo As Date) As Boolean
    Dim s As String
    s = Trim$(rawInput)

    hasDateFilter = False
    dateFrom = 0
    dateTo = 0
    ParseDateFilterInput = True

    If Len(s) = 0 Then Exit Function   ' blank = no filter, still a success

    ' A single date is "DD/MM/YYYY" (two slashes). A range is two of those
    ' joined by a dash: "DD/MM/YYYY-DD/MM/YYYY". Splitting on "-" is safe
    ' because dates use "/" as their separator, not "-".
    Dim parts() As String
    parts = Split(s, "-")

    If UBound(parts) = 0 Then
        ' single date
        If Not ParseDDMMYYYY(parts(0), dateFrom) Then
            ParseDateFilterInput = False
            Exit Function
        End If
        dateTo = dateFrom
        hasDateFilter = True

    ElseIf UBound(parts) = 1 Then
        ' range: "DD/MM/YYYY-DD/MM/YYYY"
        If Not ParseDDMMYYYY(parts(0), dateFrom) Then
            ParseDateFilterInput = False
            Exit Function
        End If
        If Not ParseDDMMYYYY(parts(1), dateTo) Then
            ParseDateFilterInput = False
            Exit Function
        End If
        If dateFrom > dateTo Then
            Dim tmp As Date
            tmp = dateFrom
            dateFrom = dateTo
            dateTo = tmp
        End If
        hasDateFilter = True

    Else
        ParseDateFilterInput = False
        Exit Function
    End If
End Function

' Returns True if cellValue's date falls within [dateFrom, dateTo] (inclusive,
' time-of-day ignored). If hasDateFilter is False, always returns True.
Private Function DateInRange(ByVal cellValue As Variant, _
                              ByVal hasDateFilter As Boolean, _
                              ByVal dateFrom As Date, _
                              ByVal dateTo As Date) As Boolean
    If Not hasDateFilter Then
        DateInRange = True
        Exit Function
    End If
    If Not IsDate(cellValue) Then
        DateInRange = False
        Exit Function
    End If
    Dim d As Date
    d = Int(CDate(cellValue))
    DateInRange = (d >= dateFrom And d <= dateTo)
End Function

' For rows that ARE a stay range themselves (e.g. ETB2 -> ETU2, a vessel's
' whole time in port), returns True if that stay range overlaps AT ALL with
' the user's filter range [dateFrom, dateTo] - not just an exact date match.
' dateFrom/dateTo are day-only (no time); the filter is treated as covering
' the full 24 hours of every day in that range, i.e. 00:00:00 on dateFrom
' through 23:59:59 on dateTo.
Private Function DateRangesOverlap(ByVal rowFrom As Date, ByVal rowTo As Date, _
                                    ByVal hasDateFilter As Boolean, _
                                    ByVal dateFrom As Date, ByVal dateTo As Date) As Boolean
    If Not hasDateFilter Then
        DateRangesOverlap = True
        Exit Function
    End If
    If rowTo < rowFrom Then   ' guard against bad/swapped data
        Dim tmp As Date
        tmp = rowFrom
        rowFrom = rowTo
        rowTo = tmp
    End If
    Dim filterEnd As Date
    filterEnd = dateTo + 1 - (1 / 86400)   ' 23:59:59 on dateTo
    DateRangesOverlap = (rowFrom <= filterEnd) And (rowTo >= dateFrom)
End Function

' Human-readable text for the date filter, used in summaries/email notes.
Private Function DateFilterDisplayText(ByVal hasDateFilter As Boolean, _
                                        ByVal dateFrom As Date, _
                                        ByVal dateTo As Date) As String
    If Not hasDateFilter Then
        DateFilterDisplayText = ""
    ElseIf dateFrom = dateTo Then
        DateFilterDisplayText = Format(dateFrom, "dd/mm/yyyy")
    Else
        DateFilterDisplayText = Format(dateFrom, "dd/mm/yyyy") & " to " & Format(dateTo, "dd/mm/yyyy")
    End If
End Function

