' BUILD LOAD_VESSEL_LIST LOOKUP DICTIONARY
'========================================================
Private Function BuildLoadVesselDict(ByVal wbL As Workbook) As Object
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = 1

    Dim wsL As Worksheet
    Dim sh  As Worksheet
    For Each sh In wbL.Worksheets
        If InStr(1, sh.Name, "Load_Vessel_List", vbTextCompare) > 0 Then
            Set wsL = sh
            Exit For
        End If
    Next sh

    If wsL Is Nothing Then
        For Each sh In wbL.Worksheets
            If FindColumnContains(sh, "LOAD OVERSTOW", 30) > 0 And _
               FindColumnContains(sh, "PORTMARK OVERSTOW", 30) > 0 Then
                Set wsL = sh
                Exit For
            End If
        Next sh
    End If
    If wsL Is Nothing Then Set wsL = wbL.ActiveSheet

    Dim hdrL As Long
    hdrL = FindColumnContainsRow(wsL, "LOAD OVERSTOW", 50)
    If hdrL = 0 Then hdrL = FindColumnContainsRow(wsL, "PORTMARK OVERSTOW", 50)
    If hdrL = 0 Then hdrL = 1

    Dim colVslL As Long
    colVslL = FindColAny(wsL, hdrL, Array("VSL / OUTVOY", "VSL / OUT LINE", "Vessel Name", "VSL", "VESSEL"))
    If colVslL = 0 Then
        Dim rr As Long
        For rr = 1 To hdrL
            Dim cc As Range
            Set cc = wsL.Rows(rr).Find(What:="VSL", LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
            If Not cc Is Nothing Then
                colVslL = cc.Column
                If hdrL < rr Then hdrL = rr
                Exit For
            End If
        Next rr
    End If
    If colVslL = 0 Then
        Set BuildLoadVesselDict = dict
        Exit Function
    End If

    Dim colLO  As Long
    Dim colPO  As Long
    Dim colMWO As Long
    colLO = FindColumnContains(wsL, "LOAD OVERSTOW", hdrL + 5)
    colPO = FindColumnContains(wsL, "PORTMARK OVERSTOW", hdrL + 5)
    colMWO = FindColumnContains(wsL, "MIX WEIGHT OVERSTOW", hdrL + 5)

    Dim lastRowL As Long
    lastRowL = LastDataRow(wsL, colVslL, hdrL)

    Dim rl     As Long
    Dim vslKey As String
    Dim vslRaw As String
    Dim loVal  As Variant
    Dim poVal  As Variant
    Dim mwoVal As Variant

    For rl = hdrL + 1 To lastRowL
        vslRaw = CleanText(wsL.Cells(rl, colVslL).Value)
        If Len(vslRaw) = 0 Then GoTo NextLoadRow
        If UCase$(vslRaw) = "GRAND TOTAL" Or UCase$(vslRaw) = "TOTAL" Then GoTo NextLoadRow

        vslKey = VslBaseName(vslRaw)
        If Len(vslKey) = 0 Then GoTo NextLoadRow

        loVal = 0
        poVal = 0
        mwoVal = 0
        If colLO > 0 Then loVal = wsL.Cells(rl, colLO).Value
        If colPO > 0 Then poVal = wsL.Cells(rl, colPO).Value
        If colMWO > 0 Then mwoVal = wsL.Cells(rl, colMWO).Value

        Dim dLO  As Double
        Dim dPO  As Double
        Dim dMWO As Double
        dLO = 0
        dPO = 0
        dMWO = 0
        If Not IsError(loVal) And IsNumeric(loVal) Then dLO = CDbl(loVal)
        If Not IsError(poVal) And IsNumeric(poVal) Then dPO = CDbl(poVal)
        If Not IsError(mwoVal) And IsNumeric(mwoVal) Then dMWO = CDbl(mwoVal)

        If Not dict.Exists(vslKey) Then
            dict.Add vslKey, Array(dLO, dPO, dMWO)
        Else
            Dim existing As Variant
            existing = dict(vslKey)
            Dim newLO  As Double
            Dim newPO  As Double
            Dim newMWO As Double
            newLO = 0
            newPO = 0
            newMWO = 0
            If Not IsError(existing(0)) And IsNumeric(existing(0)) Then newLO = CDbl(existing(0))
            If Not IsError(existing(1)) And IsNumeric(existing(1)) Then newPO = CDbl(existing(1))
            If Not IsError(existing(2)) And IsNumeric(existing(2)) Then newMWO = CDbl(existing(2))
            newLO = newLO + dLO
            newPO = newPO + dPO
            newMWO = newMWO + dMWO
            dict(vslKey) = Array(newLO, newPO, newMWO)
        End If
NextLoadRow:
    Next rl

    Set BuildLoadVesselDict = dict
End Function

