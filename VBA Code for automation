'========================================================
Public Sub Run_All()

    '=== STEP -1: Choose which section(s) to run ===
    '   1 = Load Vessel   (main overstow table - no Distance.xlsx needed)
    '   2 = Self Service  (PPT4 / P56SE table - vessel + date + block filters)
    '   3 = Long Haul     (aRMG red-block table - needs Distance.xlsx + berth)
    '   4 = Everything    (all of the above)
    Dim modeInput As String: modeInput = "4"
    Dim modeChoice As Integer
    Dim runLoadVessel As Boolean, runSelfService As Boolean, runLongHaul As Boolean

    Do
        modeInput = InputBox( _
            "Choose what to run:" & vbCrLf & vbCrLf & _
            "1 = Load Vessel   " & vbCrLf & _
            "2 = Self Service  " & vbCrLf & _
            "3 = Long Haul (needs Distance.xlsx)" & vbCrLf & _
            "4 = Everything    (all of the above)" & vbCrLf & vbCrLf & _
            "Type 1, 2, 3 or 4.", _
            "Choose Mode", modeInput)

        If StrPtr(modeInput) = 0 Then
            MsgBox "Cancelled.", vbInformation
            Exit Sub
        End If

        If IsNumeric(Trim$(modeInput)) Then
            modeChoice = CInt(Trim$(modeInput))
        Else
            modeChoice = 0
        End If

        If modeChoice < 1 Or modeChoice > 4 Then
            MsgBox "Please type 1, 2, 3 or 4.", vbExclamation, "Invalid Choice"
            modeChoice = 0
        End If
    Loop While modeChoice = 0

    runLoadVessel = (modeChoice = 1 Or modeChoice = 4)
    runSelfService = (modeChoice = 2 Or modeChoice = 4)
    runLongHaul = (modeChoice = 3 Or modeChoice = 4)

    '=== STEP 0 / 0.25: Prompt for vessel(s), then whichever of the ===
    '=== Self Service (date + block) / Long Haul (date) filters apply. ===
    ' Built as a step loop so a mistyped entry can be corrected without
    ' cancelling the whole run: each confirmation is Yes/No/Cancel, where
    ' No = re-enter this step (pre-filled with what you typed) and
    ' Cancel = go BACK to the previous applicable step to amend it.
    Dim userInput As String: userInput = ""
    Dim filterStr As String: filterStr = ""
    Dim tokenCount As Long

    Dim ssDateInputStr As String: ssDateInputStr = ""
    Dim ssHasDateFilter As Boolean
    Dim ssDateFrom As Date, ssDateTo As Date
    Dim ssBlockInputStr As String: ssBlockInputStr = ""
    Dim ssBlockFilterStr As String: ssBlockFilterStr = ""

    Dim hasDateFilter As Boolean
    Dim dateFrom As Date, dateTo As Date
    Dim dateInputStr As String: dateInputStr = ""

    Dim dateParsedOk As Boolean
    Dim wizStep As Integer
    wizStep = 1

    Do While wizStep >= 1 And wizStep <= 4

        Select Case wizStep

        Case 1
            '--- Vessel name(s) - always needed ---
            userInput = InputBox( _
                "Enter vessel name(s) to process." & vbCrLf & vbCrLf & _
                "For MULTIPLE vessels, separate with commas:" & vbCrLf & _
                "   e.g.  EVER GIVEN, MAERSK ESSEX, COSCO" & vbCrLf & vbCrLf & _
                "Partial names are fine (e.g. EVER matches EVER GIVEN / 123W)." & vbCrLf & vbCrLf & _
                "Leave blank and click OK to process ALL vessels.", _
                "Select Vessel(s)", userInput)

            If StrPtr(userInput) = 0 Then
                MsgBox "Cancelled.", vbInformation
                Exit Sub
            End If

            Dim rawTokens() As String
            rawTokens = Split(userInput, ",")

            filterStr = ""
            tokenCount = 0
            Dim t As Long
            For t = LBound(rawTokens) To UBound(rawTokens)
                Dim tok As String
                tok = UCase$(Trim$(rawTokens(t)))
                If Len(tok) > 0 Then
                    If Len(filterStr) > 0 Then filterStr = filterStr & "|"
                    filterStr = filterStr & tok
                    tokenCount = tokenCount + 1
                End If
            Next t

            Dim vesselConfirm As VbMsgBoxResult
            If tokenCount > 0 Then
                Dim displayList As String
                displayList = Replace(filterStr, "|", vbCrLf)
                Dim confirmMsg As String
                If tokenCount = 1 Then
                    confirmMsg = "Vessel filter:  " & filterStr
                Else
                    confirmMsg = tokenCount & " vessel filters:" & vbCrLf & displayList
                End If
                confirmMsg = confirmMsg & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Stop"
                vesselConfirm = MsgBox(confirmMsg, vbYesNoCancel + vbQuestion, "Confirm Vessel(s)")
            Else
                vesselConfirm = MsgBox( _
                    "No vessel filter entered - ALL vessels will be processed." & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Stop", _
                    vbYesNoCancel + vbQuestion, "Confirm: All Vessels")
            End If

            Select Case vesselConfirm
                Case vbYes
                    wizStep = 2
                Case vbNo
                    ' stay on Step 1 - InputBox re-opens pre-filled with userInput
                Case Else
                    MsgBox "Cancelled.", vbInformation
                    Exit Sub
            End Select

        Case 2
            '--- Self Service: optional date filter ---
            If Not runSelfService Then wizStep = 3: GoTo NextWizStep

            ssDateInputStr = InputBox( _
                "Enter a date filter (optional) for the SELF SERVICE table" & vbCrLf & _
                "(PPT4 / P56SE), matched against ETB2/ETU2." & vbCrLf & vbCrLf & _
                "Format is always DD/MM/YYYY (day/month/year)." & vbCrLf & vbCrLf & _
                "For a SINGLE DATE:" & vbCrLf & "   e.g.  15/07/2026  =  15 July 2026" & vbCrLf & vbCrLf & _
                "For a DATE RANGE, separate with a dash:" & vbCrLf & "   e.g.  15/07/2026-20/07/2026" & vbCrLf & vbCrLf & _
                "Leave blank and click OK to process ALL dates." & vbCrLf & vbCrLf & _
                "(Click Cancel to go back and change the vessel name(s).)", _
                "Self Service - Filter by Date", ssDateInputStr)

            If StrPtr(ssDateInputStr) = 0 Then
                wizStep = 1
                GoTo NextWizStep
            End If

            dateParsedOk = ParseDateFilterInput(ssDateInputStr, ssHasDateFilter, ssDateFrom, ssDateTo)
            If Not dateParsedOk Then
                MsgBox "Could not understand that date. Please use DD/MM/YYYY," & vbCrLf & _
                       "or DD/MM/YYYY-DD/MM/YYYY for a range.", vbExclamation, "Invalid Date"
                GoTo NextWizStep
            End If

            Dim ssDateConfirm As VbMsgBoxResult
            If ssHasDateFilter Then
                Dim ssDateConfirmMsg As String
                If ssDateFrom = ssDateTo Then
                    ssDateConfirmMsg = "Self Service date filter:  " & Format(ssDateFrom, "dd/mm/yyyy (dddd)")
                Else
                    ssDateConfirmMsg = "Self Service date filter:  " & Format(ssDateFrom, "dd/mm/yyyy (dddd)") & _
                                        "  to  " & Format(ssDateTo, "dd/mm/yyyy (dddd)")
                End If
                ssDateConfirmMsg = ssDateConfirmMsg & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to vessel(s)"
                ssDateConfirm = MsgBox(ssDateConfirmMsg, vbYesNoCancel + vbQuestion, "Confirm Date Filter")
            Else
                ssDateConfirm = MsgBox( _
                    "No date filter entered - ALL dates will be processed (Self Service table)." & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to vessel(s)", _
                    vbYesNoCancel + vbQuestion, "Confirm: All Dates")
            End If

            Select Case ssDateConfirm
                Case vbYes
                    wizStep = 3
                Case vbNo
                    ' stay on Step 2 - InputBox re-opens pre-filled with ssDateInputStr
                Case Else
                    wizStep = 1   ' back to vessel step
            End Select

        Case 3
            '--- Self Service: optional Block filter ---
            If Not runSelfService Then wizStep = 4: GoTo NextWizStep

            ssBlockInputStr = InputBox( _
                "Enter Block(s) to filter the SELF SERVICE table (optional)." & vbCrLf & vbCrLf & _
                "For MULTIPLE blocks, separate with commas:" & vbCrLf & _
                "   e.g.  TA01, TB02" & vbCrLf & vbCrLf & _
                "Leave blank and click OK to process ALL blocks." & vbCrLf & vbCrLf & _
                "(Click Cancel to go back and change the date filter.)", _
                "Self Service - Filter by Block", ssBlockInputStr)

            If StrPtr(ssBlockInputStr) = 0 Then
                wizStep = 2
                GoTo NextWizStep
            End If

            Dim rawBlockTokens() As String
            rawBlockTokens = Split(ssBlockInputStr, ",")

            ssBlockFilterStr = ""
            Dim blkTokenCount As Long
            blkTokenCount = 0
            Dim bt As Long
            For bt = LBound(rawBlockTokens) To UBound(rawBlockTokens)
                Dim blkTok As String
                blkTok = UCase$(Trim$(rawBlockTokens(bt)))
                If Len(blkTok) > 0 Then
                    If Len(ssBlockFilterStr) > 0 Then ssBlockFilterStr = ssBlockFilterStr & "|"
                    ssBlockFilterStr = ssBlockFilterStr & blkTok
                    blkTokenCount = blkTokenCount + 1
                End If
            Next bt

            Dim ssBlockConfirm As VbMsgBoxResult
            If blkTokenCount > 0 Then
                ssBlockConfirm = MsgBox( _
                    "Self Service block filter:  " & Replace(ssBlockFilterStr, "|", ", ") & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to date filter", _
                    vbYesNoCancel + vbQuestion, "Confirm Block(s)")
            Else
                ssBlockConfirm = MsgBox( _
                    "No block filter entered - ALL blocks will be processed (Self Service table)." & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to date filter", _
                    vbYesNoCancel + vbQuestion, "Confirm: All Blocks")
            End If

            Select Case ssBlockConfirm
                Case vbYes
                    wizStep = 4
                Case vbNo
                    ' stay on Step 3 - InputBox re-opens pre-filled with ssBlockInputStr
                Case Else
                    wizStep = 2   ' back to self service date step
            End Select

        Case 4
            '--- Long Haul: optional date / date-range filter ---
            If Not runLongHaul Then wizStep = 5: GoTo NextWizStep

            dateInputStr = InputBox( _
                "Enter a date filter (optional) - applies ONLY to the Long Haul" & vbCrLf & _
                "(aRMG red distance blocks) table, matched against ETB2/ETU2." & vbCrLf & vbCrLf & _
                "Format is always DD/MM/YYYY (day/month/year)." & vbCrLf & vbCrLf & _
                "For a SINGLE DATE:" & vbCrLf & "   e.g.  15/07/2026  =  15 July 2026" & vbCrLf & vbCrLf & _
                "For a DATE RANGE, separate with a dash:" & vbCrLf & "   e.g.  15/07/2026-20/07/2026" & vbCrLf & vbCrLf & _
                "Leave blank and click OK to process ALL dates." & vbCrLf & vbCrLf & _
                "(Click Cancel to go back and change the previous filter.)", _
                "Long Haul - Filter by Date", dateInputStr)

            If StrPtr(dateInputStr) = 0 Then
                wizStep = IIf(runSelfService, 3, 1)
                GoTo NextWizStep
            End If

            dateParsedOk = ParseDateFilterInput(dateInputStr, hasDateFilter, dateFrom, dateTo)
            If Not dateParsedOk Then
                MsgBox "Could not understand that date. Please use DD/MM/YYYY," & vbCrLf & _
                       "or DD/MM/YYYY-DD/MM/YYYY for a range.", vbExclamation, "Invalid Date"
                GoTo NextWizStep
            End If

            Dim dateConfirm As VbMsgBoxResult
            If hasDateFilter Then
                Dim dateConfirmMsg As String
                If dateFrom = dateTo Then
                    dateConfirmMsg = "Long Haul date filter:  " & Format(dateFrom, "dd/mm/yyyy (dddd)")
                Else
                    dateConfirmMsg = "Long Haul date filter:  " & Format(dateFrom, "dd/mm/yyyy (dddd)") & _
                                      "  to  " & Format(dateTo, "dd/mm/yyyy (dddd)")
                End If
                dateConfirmMsg = dateConfirmMsg & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to previous filter"
                dateConfirm = MsgBox(dateConfirmMsg, vbYesNoCancel + vbQuestion, "Confirm Date Filter")
            Else
                dateConfirm = MsgBox( _
                    "No date filter entered - ALL dates will be processed (Long Haul table)." & vbCrLf & vbCrLf & _
                    "Yes = Continue     No = Re-enter this" & vbCrLf & "Cancel = Back to previous filter", _
                    vbYesNoCancel + vbQuestion, "Confirm: All Dates")
            End If

            Select Case dateConfirm
                Case vbYes
                    wizStep = 5
                Case vbNo
                    ' stay on Step 4 - InputBox re-opens pre-filled with dateInputStr
                Case Else
                    wizStep = IIf(runSelfService, 3, 1)   ' back to previous applicable step
            End Select

        End Select

NextWizStep:
    Loop

    '=== STEP 0.5: Distance.xlsx + Self_Service pivots ===
    ' Distance.xlsx is ONLY required for Long Haul. Self Service does not
    ' need it at all.
    Dim wbDist As Workbook

    If runLongHaul Then
        Set wbDist = GetDistanceWb(ThisWorkbook.Path)
        If wbDist Is Nothing Then
            MsgBox "Long Haul requires Distance.xlsx, but it could not be found in:" & vbCrLf & _
                   ThisWorkbook.Path & vbCrLf & vbCrLf & _
                   "Please make sure Distance.xlsx is in that folder and try again.", vbCritical
            Exit Sub
        End If
        PromptDistanceBerth wbDist
        Setup_SelfService_Pivot
        Apply_ARMG_Block_Filter_To_SelfService wbDist
    End If

    If runSelfService Then
        Setup_SelfServicing_Pivot ssBlockFilterStr
    End If

    '=== STEP 1-2: Yard_Buildup_Quality pivot (Load Vessel table only) ===
    If runLoadVessel Then

        Dim wbY As Workbook
        Dim wsY As Worksheet
        Dim pt  As PivotTable

        Set wbY = GetWbByNamePart("Yard_Buildup_Quality")
        If wbY Is Nothing Then
            MsgBox "Cannot find Yard_Buildup_Quality workbook. Please open it first.", vbExclamation
            Exit Sub
        End If

        Dim sh As Worksheet
        For Each sh In wbY.Worksheets
            If sh.PivotTables.Count > 0 Then
                On Error Resume Next
                Dim testPF As PivotField
                Set testPF = sh.PivotTables(1).PivotFields("vsl2_bthTerm")
                On Error GoTo 0
                If Not testPF Is Nothing Then
                    Set wsY = sh
                    Set pt = sh.PivotTables(1)
                    Exit For
                End If
            End If
        Next sh

        If pt Is Nothing Then
            MsgBox "Cannot find pivot table with 'vsl2_bthTerm' field in Yard_Buildup_Quality.", vbExclamation
            Exit Sub
        End If

        Application.ScreenUpdating = False
        pt.ManualUpdate = True
        On Error Resume Next
        pt.PivotFields("alongSide").ClearAllFilters
        pt.PivotFields("alongSide").CurrentPage = "(All)"
        pt.PivotFields("doubleBerthing").ClearAllFilters
        pt.PivotFields("doubleBerthing").CurrentPage = "(All)"
        On Error GoTo 0
        HidePivotFieldSafe pt, "%Small_Lot"
        AddValueFieldSafe pt, "%Overstow", "%Overs", "0%"
        AddValueFieldSafe pt, "%Overstow_inClr", "Overstow_in", "0.0000"
        AddValueFieldSafe pt, "%Overstow_outClr", "Overstow_out", "0.0000"
        ForceValuesToColumns pt
        HidePivotFieldSafe pt, "Clrs"
        HidePivotFieldSafe pt, "avgSlots"
        HidePivotFieldSafe pt, "boxPerClr"
        FilterPivot_PPT4_PPT5_ExplicitNoTuas pt
        FilterPivot_Berth_P1_To_P41 pt
        pt.ManualUpdate = False
        Application.ScreenUpdating = True

    End If

    '=== STEP 3: Build FINAL (if needed) + Email ===
    Call Build_FINAL_Then_Email_PSA(filterStr, hasDateFilter, dateFrom, dateTo, _
                                     runLoadVessel, runSelfService, runLongHaul, _
                                     ssHasDateFilter, ssDateFrom, ssDateTo, ssBlockFilterStr)

End Sub




