'========================================================
' SELF_SERVICE WORKING-COPY HELPERS
'========================================================
' All Long Haul / aRMG filtering works off a disposable COPY of the
' Self_Service tab, so the original "Self_Service" tab and its pivot are
' never modified by the macro. The copy is deleted and rebuilt fresh at the
' start of every run, so nothing accumulates across repeated runs.
' (The working-copy sheet name "Long Haul" is written directly
' wherever it's needed below, rather than via a shared constant, so this
' code has no dependency on any other declaration in the module.)

' Locates the ORIGINAL Self_Service sheet (never the working copy).
Private Function GetSelfServiceSourceSheet(ByVal wbSS As Workbook) As Worksheet
    Dim wsSS As Worksheet, sh As Worksheet, testPF As PivotField

    On Error Resume Next
    Set wsSS = wbSS.Worksheets("Self_Service")
    On Error GoTo 0

    If wsSS Is Nothing Then
        For Each sh In wbSS.Worksheets
            If StrComp(sh.Name, "Long Haul", vbTextCompare) <> 0 And _
               StrComp(sh.Name, "Self Service", vbTextCompare) <> 0 Then
                If sh.PivotTables.Count > 0 Then
                    On Error Resume Next
                    Set testPF = Nothing
                    Set testPF = sh.PivotTables(1).PivotFields("Block")
                    On Error GoTo 0
                    If Not testPF Is Nothing Then
                        Set wsSS = sh
                        Exit For
                    End If
                End If
            End If
        Next sh
    End If

    Set GetSelfServiceSourceSheet = wsSS
End Function

' Returns the disposable "Long Haul" working copy.
'   forceRecreate:=True  -> always delete any old copy and rebuild fresh from
'                            the source sheet (use this ONCE, at the start of
'                            a run, e.g. in Setup_SelfService_Pivot).
'   forceRecreate:=False -> reuse the copy already created earlier in this
'                            same run (use this in every later step, e.g.
'                            Apply_ARMG_Block_Filter_To_SelfService and
'                            BuildSelfServiceRedBlockHtml), so their edits
'                            land on the same sheet instead of each starting
'                            over from a blank copy.
Private Function GetSelfServiceWorkingSheet(ByVal wbSS As Workbook, _
                                             Optional ByVal forceRecreate As Boolean = True) As Worksheet
    Dim wsExisting As Worksheet
    On Error Resume Next
    Set wsExisting = wbSS.Worksheets("Long Haul")
    On Error GoTo 0

    If Not forceRecreate And Not wsExisting Is Nothing Then
        Set GetSelfServiceWorkingSheet = wsExisting
        Exit Function
    End If

    Dim wsSource As Worksheet
    Set wsSource = GetSelfServiceSourceSheet(wbSS)
    If wsSource Is Nothing Then
        Set GetSelfServiceWorkingSheet = Nothing
        Exit Function
    End If

    Application.DisplayAlerts = False
    If Not wsExisting Is Nothing Then wsExisting.Delete
    Application.DisplayAlerts = True

    wsSource.Copy After:=wbSS.Worksheets(wbSS.Worksheets.Count)

    Dim wsNew As Worksheet
    Set wsNew = wbSS.Worksheets(wbSS.Worksheets.Count)
    On Error Resume Next
    wsNew.Name = "Long Haul"
    On Error GoTo 0

    Set GetSelfServiceWorkingSheet = wsNew
End Function

Private Sub FilterSelfService_BlockToARMG(ByVal folderPath As String, ByVal blockListStr As String)
    If Len(blockListStr) = 0 Then
        MsgBox "No red-flagged aRMG Block values found - nothing to filter in Self_Service.xlsx.", vbExclamation
        Exit Sub
    End If

    Dim wbSS As Workbook
    Set wbSS = GetSelfServiceWb(folderPath)
    If wbSS Is Nothing Then
        MsgBox "Cannot find/open Self_Service.xlsx/.xlsm in: " & folderPath, vbExclamation
        Exit Sub
    End If

    Dim wsSS As Worksheet, ptSS As PivotTable
    Set wsSS = GetSelfServiceWorkingSheet(wbSS, forceRecreate:=False)

    If wsSS Is Nothing Or wsSS.PivotTables.Count = 0 Then
        MsgBox "Cannot find the pivot table with a 'Block' field in Self_Service.xlsx.", vbExclamation
        Exit Sub
    End If
    Set ptSS = wsSS.PivotTables(1)

    Dim pf As PivotField
    On Error Resume Next
    Set pf = ptSS.PivotFields("Block")
    On Error GoTo 0
    If pf Is Nothing Then
        MsgBox "'Block' field not found on the pivot table in Self_Service.xlsx.", vbExclamation
        Exit Sub
    End If

    Dim allowedBlocks() As String
    allowedBlocks = Split(blockListStr, "|")

    Dim pi As PivotItem
    ptSS.ManualUpdate = True

    ' --- Lock CT and Terminal_ID to the required values ---
     FilterSelfService_PageField ptSS, "CT", Array("PPT4-6")
     FilterSelfService_PageField ptSS, "Terminal_ID", Array("PPT4", "P56SE")
    ' --------------------------------------------------------------

    pf.EnableMultiplePageItems = True

    For Each pi In pf.PivotItems
        On Error Resume Next
        pi.Visible = True
        On Error GoTo 0
    Next pi

    Dim isAllowed As Boolean, a As Long
    For Each pi In pf.PivotItems
        isAllowed = False
        For a = LBound(allowedBlocks) To UBound(allowedBlocks)
            If StrComp(pi.Name, allowedBlocks(a), vbTextCompare) = 0 Then
                isAllowed = True
                Exit For
            End If
        Next a
        If Not isAllowed Then
            On Error Resume Next
            pi.Visible = False
            On Error GoTo 0
        End If
    Next pi

    ptSS.ManualUpdate = False

End Sub


 
 
 
 
 Private Sub Setup_SelfService_Pivot_Layout(ByVal pt As PivotTable)

    Dim pf As PivotField
    Dim wantedFields As Variant
    Dim i As Long, isWanted As Boolean

    wantedFields = Array("Slot", "Terminal_ID", "CT", "ETB2", "ETU2", "Vsl_Voy2", "Block", "Cntr_N")

    pt.ManualUpdate = True
    On Error Resume Next

    '--- STEP 0 (NEW): wipe out ANY existing data fields first ---
    ' This is what was causing "Data" as a row header and vessels
    ' being duplicated (Count of Cntr_N / Cntr_N2)
    Dim dfCount As Long
    For dfCount = pt.DataFields.Count To 1 Step -1
        pt.DataFields(dfCount).Orientation = xlHidden
    Next dfCount

    '--- Step 1: hide every field NOT in our wanted list ---
    For Each pf In pt.PivotFields
        isWanted = False
        For i = LBound(wantedFields) To UBound(wantedFields)
            If StrComp(pf.Name, CStr(wantedFields(i)), vbTextCompare) = 0 Then
                isWanted = True
                Exit For
            End If
        Next i
        If Not isWanted Then pf.Orientation = xlHidden
    Next pf

    '--- Step 2: Filters ---
    pt.PivotFields("Slot").Orientation = xlPageField
    pt.PivotFields("Slot").Position = 1
    pt.PivotFields("Terminal_ID").Orientation = xlPageField
    pt.PivotFields("Terminal_ID").Position = 2
    pt.PivotFields("CT").Orientation = xlPageField
    pt.PivotFields("CT").Position = 3

    '--- Step 3: Rows ---
    pt.PivotFields("ETB2").Orientation = xlRowField
    pt.PivotFields("ETB2").Position = 1
    pt.PivotFields("ETU2").Orientation = xlRowField
    pt.PivotFields("ETU2").Position = 2
    pt.PivotFields("Vsl_Voy2").Orientation = xlRowField
    pt.PivotFields("Vsl_Voy2").Position = 3

    '--- Step 4: Columns ---
    pt.PivotFields("Block").Orientation = xlColumnField
    pt.PivotFields("Block").Position = 1

    '--- Step 5: Values - exactly ONE field ---
    Dim pfData As PivotField
    Set pfData = pt.PivotFields("Cntr_N")
    pfData.Orientation = xlDataField
    pfData.Function = xlCount
    pfData.caption = "Count of Cntr_N"

    ' Keep the invisible "S Values" field pinned to Columns, never Rows
    ForceValuesToColumns pt

    On Error GoTo 0
    pt.ManualUpdate = False

End Sub

