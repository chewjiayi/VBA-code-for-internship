Private Function NormalizePct(ByVal v As Variant) As Variant
    If IsError(v) Then Exit Function
    If Len(CStr(v)) = 0 Then Exit Function
    If Not IsNumeric(v) Then Exit Function
    Dim x As Double
    x = CDbl(v)
    If x < 0 Then Exit Function
    If x > 1 And x <= 100 Then x = x / 100#
    NormalizePct = x
End Function

Private Function IsAllowedTRMNL(ByVal s As String) As Boolean
    s = UCase$(Trim$(s))
    IsAllowedTRMNL = (s = "P56SE" Or s = "PPT4")
End Function

Private Function IsBadBTH(ByVal s As String, Optional ByVal badStarts As String = "BTK") As Boolean
    s = UCase$(Trim$(s))
    If Len(s) = 0 Then
        IsBadBTH = False
    Else
        IsBadBTH = (InStr(1, badStarts, Left$(s, 1), vbTextCompare) > 0)
    End If
End Function

Private Function VslBaseName(ByVal s As String) As String
    s = Trim$(s)
    Dim pos As Long
    pos = InStr(s, "/")
    If pos > 1 Then
        VslBaseName = UCase$(Trim$(Left$(s, pos - 1)))
    Else
        VslBaseName = UCase$(s)
    End If
End Function

