Private Function OpenLatestFile(ByVal folderPath As String, ByVal pattern As String) As Workbook
    Dim f As String, bestFile As String
    Dim bestDate As Date, dt As Date
    If Right(folderPath, 1) <> "\" Then folderPath = folderPath & "\"
    f = dir(folderPath & pattern)
    Do While f <> ""
        If Not Left$(f, 2) = "~$" Then
            dt = FileDateTime(folderPath & f)
            If dt > bestDate Then
                bestDate = dt
                bestFile = folderPath & f
            End If
        End If
        f = dir
    Loop
    If bestFile <> "" Then
        Set OpenLatestFile = Workbooks.Open(bestFile)
    End If
End Function

'========================================================
' IDENTIFY VESSEL SHEET
'========================================================
Private Function SheetLooksLikeVessel(ByVal ws As Worksheet) As Boolean
    Dim hdr As Long
    hdr = FindHeaderRow(ws, "TRMNL", 150)
    If hdr = 0 Then hdr = FindHeaderRow(ws, "VSL", 150)
    If hdr = 0 Then Exit Function
    SheetLooksLikeVessel = _
        (FindColAny(ws, hdr, Array("VSL / OUTVOY", "VSL / OUT LINE", "VSL")) > 0) And _
        (FindColByHeader(ws, hdr, "TRMNL") > 0) And _
        (FindColByHeader(ws, hdr, "BTH") > 0) And _
        (FindColAny(ws, hdr, Array("ETB", "ETB2")) > 0)
End Function

Private Function FindVesselWorkbook_OpenFirst() As Workbook
    Dim wb As Workbook, ws As Worksheet
    For Each wb In Application.Workbooks
        For Each ws In wb.Worksheets
            If SheetLooksLikeVessel(ws) Then
                Set FindVesselWorkbook_OpenFirst = wb
                Exit Function
            End If
        Next ws
    Next wb
End Function

Private Function OpenVesselWorkbook_FromFolder(ByVal folderPath As String) As Workbook
    Dim patterns As Variant, p As Variant
    Dim wb As Workbook
    patterns = Array( _
        "vessel-list_*.xlsx", "vessel-list_*.xlsm", _
        "vesselListReport_*.xlsx", "vesselListReport_*.xlsm", _
        "vessel*list.xlsx", "vessel*list.xlsm" _
    )
    For Each p In patterns
        Set wb = OpenLatestFile(folderPath, CStr(p))
        If Not wb Is Nothing Then
            Set OpenVesselWorkbook_FromFolder = wb
            Exit Function
        End If
    Next p
End Function

Private Function GetVesselWorkbookSmart(ByVal folderPath As String) As Workbook
    Dim wb As Workbook, ws As Worksheet
    Set wb = FindVesselWorkbook_OpenFirst()
    If Not wb Is Nothing Then
        Set GetVesselWorkbookSmart = wb
        Exit Function
    End If
    Set wb = OpenVesselWorkbook_FromFolder(folderPath)
    If Not wb Is Nothing Then
        For Each ws In wb.Worksheets
            If SheetLooksLikeVessel(ws) Then
                Set GetVesselWorkbookSmart = wb
                Exit Function
            End If
        Next ws
    End If
    Set GetVesselWorkbookSmart = Nothing
End Function

