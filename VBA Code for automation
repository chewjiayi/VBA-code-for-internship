'------------------------------------------------------------
' Reads the live "Self Service" pivot (Terminal_ID = PPT4/P56SE,
' Rows: Block > Vsl_Voy2 > ETB2 > ETU2, Values: Count of Cntr_N)
' and builds a simple HTML table for the email:
'   Block | Vsl_Voy2 | ETB2 | ETU2 | Count
'------------------------------------------------------------
Private Function BuildSelfServicingHtml(ByVal folderPath As String, _
                                         Optional ByVal filterStr As String = "", _
                                         Optional ByVal hasDateFilter As Boolean = False, _
                                         Optional ByVal dateFrom As Date = 0, _
                                         Optional ByVal dateTo As Date = 0, _
                                         Optional ByVal blockFilterStr As String = "") As String

    Dim wbSS As Workbook
    Dim wsSS As Worksheet
    Dim ptSS As PivotTable

    Set wbSS = GetSelfServiceWb(folderPath)
    If wbSS Is Nothing Then
        BuildSelfServicingHtml = ""
        Exit Function
    End If

    Set wsSS = GetSelfServicingWorkingSheet(wbSS, forceRecreate:=False)
    If wsSS Is Nothing Or wsSS.PivotTables.Count = 0 Then
        BuildSelfServicingHtml = ""
        Exit Function
    End If
    Set ptSS = wsSS.PivotTables(1)

    Dim rowRng As Range, dataRng As Range
    On Error Resume Next
    Set rowRng = ptSS.RowRange
    Set dataRng = ptSS.DataBodyRange
    On Error GoTo 0

    If rowRng Is Nothing Or dataRng Is Nothing Then
        BuildSelfServicingHtml = ""
        Exit Function
    End If

    Dim valCaption As String
    On Error Resume Next
    valCaption = ptSS.DataFields(1).caption
    On Error GoTo 0
    If Len(valCaption) = 0 Then valCaption = "Count"

    Dim nRowLevels As Long
    nRowLevels = rowRng.Columns.Count   ' Block, Vsl_Voy2, ETB2, ETU2 = 4

    Dim blockCol As Long, vslCol As Long, etbCol As Long, etuCol As Long
    On Error Resume Next
    blockCol = ptSS.PivotFields("Block").DataRange.Column - rowRng.Column + 1
    vslCol = ptSS.PivotFields("Vsl_Voy2").DataRange.Column - rowRng.Column + 1
    etbCol = ptSS.PivotFields("ETB2").DataRange.Column - rowRng.Column + 1
    etuCol = ptSS.PivotFields("ETU2").DataRange.Column - rowRng.Column + 1
    On Error GoTo 0

    If blockCol < 1 Or vslCol < 1 Or etbCol < 1 Or etuCol < 1 Then
        BuildSelfServicingHtml = ""
        Exit Function
    End If

    Dim fillVals() As String
    ReDim fillVals(1 To nRowLevels)

    Dim nRows As Long
    nRows = dataRng.Rows.Count

    Dim bodyRows As String
    Dim anyRow As Boolean
    anyRow = False

    Dim r As Long, lvl As Long
    Dim grandTotal As Double
    grandTotal = 0
    Dim etbFillDate As Variant, etuFillDate As Variant

    For r = 1 To nRows

        Dim leafVal As String
        leafVal = CleanText(rowRng.Cells(r, nRowLevels).Value)

        For lvl = 1 To nRowLevels
            Dim cellTxt As String
            Dim rawVal As Variant
            rawVal = rowRng.Cells(r, lvl).Value
            cellTxt = CleanText(rawVal)
            If Len(cellTxt) > 0 Then
                fillVals(lvl) = cellTxt
                If lvl = etbCol Then etbFillDate = rawVal
                If lvl = etuCol Then etuFillDate = rawVal
            End If
        Next lvl

        If Len(leafVal) = 0 Then GoTo NextSSRow
        If InStr(1, leafVal, "total", vbTextCompare) > 0 Then GoTo NextSSRow
        If InStr(1, fillVals(nRowLevels), "total", vbTextCompare) > 0 Then GoTo NextSSRow
        If InStr(1, leafVal, "Count of", vbTextCompare) > 0 Then GoTo NextSSRow

        '=== VESSEL NAME FILTER (matches Vsl_Voy2) ===
        If Not MatchesAnyVessel(fillVals(vslCol), filterStr) Then GoTo NextSSRow
        '==============================================

        '=== BLOCK FILTER (matches Block) ===
        If Not MatchesAnyVessel(fillVals(blockCol), blockFilterStr) Then GoTo NextSSRow
        '=====================================

        '=== DATE FILTER (row's stay = ETB2 -> ETU2 must overlap the requested range) ===
        If hasDateFilter Then
            If Not (IsDate(etbFillDate) And IsDate(etuFillDate)) Then GoTo NextSSRow
            If Not DateRangesOverlap(CDate(etbFillDate), CDate(etuFillDate), _
                                      hasDateFilter, dateFrom, dateTo) Then GoTo NextSSRow
        End If
        '================================================================================

        Dim cVal As Variant
        cVal = dataRng.Cells(r, 1).Value
        If Not IsNumeric(cVal) Then GoTo NextSSRow
        If CDbl(cVal) <= 0 Then GoTo NextSSRow

        grandTotal = grandTotal + CDbl(cVal)
        anyRow = True

        bodyRows = bodyRows & "<tr style='background-color:#E2EFDA;'>" & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & HtmlEncode(fillVals(blockCol)) & "</td>" & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & HtmlEncode(fillVals(vslCol)) & "</td>" & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & HtmlEncode(fillVals(etbCol)) & "</td>" & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & HtmlEncode(fillVals(etuCol)) & "</td>" & _
            "<td style='text-align:center;padding:8px;color:#375623;font-weight:bold;'>" & HtmlEncode(CStr(CLng(cVal))) & "</td>" & _
            "</tr>"

NextSSRow:
    Next r

    If Not anyRow Then
        BuildSelfServicingHtml = ""
        Exit Function
    End If

    Dim html As String
    html = "<br><br><p><b>Self Service (PPT4 / P56SE):</b>"
    Dim noteBits As String
    If Len(filterStr) > 0 Then noteBits = noteBits & "vessel(s): " & Replace(filterStr, "|", ", ")
    If Len(blockFilterStr) > 0 Then
        If Len(noteBits) > 0 Then noteBits = noteBits & "; "
        noteBits = noteBits & "block(s): " & Replace(blockFilterStr, "|", ", ")
    End If
    If hasDateFilter Then
        If Len(noteBits) > 0 Then noteBits = noteBits & "; "
        noteBits = noteBits & "date: " & DateFilterDisplayText(hasDateFilter, dateFrom, dateTo)
    End If
    If Len(noteBits) > 0 Then
        html = html & "  <span style='font-weight:normal;'>(filtered to " & HtmlEncode(noteBits) & ")</span>"
    End If
    html = html & "</p>"

    html = html & "<table border='1' cellpadding='8' cellspacing='0' " & _
        "style='border-collapse:collapse;font-family:Calibri;font-size:10.5pt;'>"

    html = html & "<tr><td colspan='5' " & _
        "style='background-color:#548235;color:#FFFFFF;font-weight:bold;text-align:center;font-size:12pt;padding:10px;'>" & _
        "Self Service</td></tr>"

    html = html & "<tr style='background-color:#C6E0B4;font-weight:bold;'>" & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>Block</th>" & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>Vsl_Voy2</th>" & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>Start Date</th>" & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>End Date</th>" & _
        "<th style='text-align:center;padding:8px;'>Grand Total</th>" & _
        "</tr>"

    html = html & bodyRows

    html = html & "<tr style='background-color:#C6E0B4;font-weight:bold;'>" & _
        "<td colspan='4' style='text-align:right;padding:8px;'>Grand Total</td>" & _
        "<td style='text-align:center;padding:8px;'>" & HtmlEncode(CStr(CLng(grandTotal))) & "</td></tr>"

    html = html & "</table>"

    BuildSelfServicingHtml = html

End Function

