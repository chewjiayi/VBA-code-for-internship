Private Function HtmlEncode(ByVal s As String) As String
    s = CStr(s)
    s = Replace(s, "&", "&amp;")
    s = Replace(s, "<", "&lt;")
    s = Replace(s, ">", "&gt;")
    s = Replace(s, """", "&quot;")
    HtmlEncode = s
End Function


Private Function ServicingRowHasData(ByVal ws As Worksheet, ByVal r As Long, ByVal startCol As Long, ByVal lastCol As Long) As Boolean
    Dim c As Long, v As Variant
    For c = startCol To lastCol
        v = ws.Cells(r, c).Value
        If Not IsError(v) Then
            If IsNumeric(v) Then
                If CDbl(v) <> 0 Then
                    ServicingRowHasData = True
                    Exit Function
                End If
            Else
                If Len(Trim$(CStr(v))) > 0 Then
                    ServicingRowHasData = True
                    Exit Function
                End If
            End If
        End If
    Next c
    ServicingRowHasData = False
End Function

'========================================================
' VESSEL FOCUS CARDS
'========================================================
Private Function TerminalFromBerth(ByVal berthRaw As String) As String
    Dim s As String
    s = UCase$(CleanText(berthRaw))
    Dim i As Long, ch As String, numStr As String
    Dim berthNum As Long

    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If ch = "P" And i < Len(s) Then
            If IsNumeric(Mid$(s, i + 1, 1)) Then
                numStr = ""
                Dim j As Long
                j = i + 1
                Do While j <= Len(s) And IsNumeric(Mid$(s, j, 1))
                    numStr = numStr & Mid$(s, j, 1)
                    j = j + 1
                Loop
                If Len(numStr) > 0 Then
                    berthNum = CLng(numStr)
                    If berthNum >= 27 And berthNum <= 29 Then
                        TerminalFromBerth = "P4SE"
                    ElseIf berthNum >= 30 Then
                        TerminalFromBerth = "P56SE"
                    Else
                        TerminalFromBerth = "Terminal " & berthNum
                    End If
                    Exit Function
                End If
            End If
        End If
    Next i
    TerminalFromBerth = "Terminal"
End Function

Private Function BuildVesselCardsHtml(ByVal folderPath As String, ByVal filterStr As String, _
                                       Optional ByVal hasDateFilter As Boolean = False, _
                                       Optional ByVal dateFrom As Date = 0, _
                                       Optional ByVal dateTo As Date = 0) As String
    Dim wbL As Workbook
    Set wbL = GetLoadVesselListWb(folderPath)
    If wbL Is Nothing Then
        BuildVesselCardsHtml = ""
        Exit Function
    End If

    Dim wsL As Worksheet, sh As Worksheet
    For Each sh In wbL.Worksheets
        If InStr(1, sh.Name, "Load_Vessel_List", vbTextCompare) > 0 Then
            Set wsL = sh
            Exit For
        End If
    Next sh
    If wsL Is Nothing Then
        For Each sh In wbL.Worksheets
            If FindColumnContains(sh, "LOAD OVERSTOW", 30) > 0 Then
                Set wsL = sh
                Exit For
            End If
        Next sh
    End If
    If wsL Is Nothing Then Set wsL = wbL.ActiveSheet

    Dim hdrL As Long
    hdrL = FindColumnContainsRow(wsL, "LOAD OVERSTOW", 50)
    If hdrL = 0 Then
        BuildVesselCardsHtml = ""
        Exit Function
    End If

    Dim colVsl As Long, colVoy As Long, colSvc As Long, colDir As Long
    Dim colEtb As Long, colEtu As Long, colBTH As Long, colVol As Long
    Dim colLO As Long, colPO As Long, colMWO As Long, colPhantom As Long

    colVsl = FindColByHeader(wsL, hdrL, "VESSEL")
    colVoy = FindColByHeader(wsL, hdrL, "VOYAGE")
    colSvc = FindColByHeader(wsL, hdrL, "SVC")
    colDir = FindColByHeader(wsL, hdrL, "DIR")
    colEtb = FindColByHeader(wsL, hdrL, "ETB")
    colEtu = FindColByHeader(wsL, hdrL, "ETU")
    colBTH = FindColByHeader(wsL, hdrL, "BERTH")
    colVol = FindColByHeader(wsL, hdrL, "LOAD VOLUME")
    colLO = FindColumnContains(wsL, "LOAD OVERSTOW", hdrL + 5)
    colPO = FindColumnContains(wsL, "PORTMARK OVERSTOW", hdrL + 5)
    colMWO = FindColumnContains(wsL, "MIX WEIGHT OVERSTOW", hdrL + 5)
    colPhantom = FindColumnContains(wsL, "PHANTOM LOCATION", hdrL + 5)

    If colVsl = 0 Or colBTH = 0 Then
        BuildVesselCardsHtml = ""
        Exit Function
    End If

    Dim lastRowL As Long
    lastRowL = LastDataRow(wsL, colVsl, hdrL)

    Dim html As String
    Dim r As Long
    Dim vslName As String, voy As String, svc As String, dir As String
    Dim bth As String, term As String
    Dim lo As Double, po As Double, mwo As Double, phantom As Double
    Dim etbStr As String, etuStr As String

    For r = hdrL + 1 To lastRowL
        vslName = CleanText(wsL.Cells(r, colVsl).Value)
        If Len(vslName) = 0 Then GoTo NextCardRow
        If UCase$(vslName) = "GRAND TOTAL" Or UCase$(vslName) = "TOTAL" Then GoTo NextCardRow
        If Not MatchesAnyVessel(vslName, filterStr) Then GoTo NextCardRow
        ' NOTE: vessel cards are intentionally NOT date-filtered - the date
        ' filter only applies to the Long Haul (aRMG) table further down.

        lo = 0: po = 0: mwo = 0: phantom = 0
        If colLO > 0 And IsNumeric(wsL.Cells(r, colLO).Value) Then lo = CDbl(wsL.Cells(r, colLO).Value)
        If colPO > 0 And IsNumeric(wsL.Cells(r, colPO).Value) Then po = CDbl(wsL.Cells(r, colPO).Value)
        If colMWO > 0 And IsNumeric(wsL.Cells(r, colMWO).Value) Then mwo = CDbl(wsL.Cells(r, colMWO).Value)
        If colPhantom > 0 And IsNumeric(wsL.Cells(r, colPhantom).Value) Then phantom = CDbl(wsL.Cells(r, colPhantom).Value)

        If lo <= 0 And po <= 0 And mwo <= 0 And phantom <= 0 Then GoTo NextCardRow

        voy = IIf(colVoy > 0, CleanText(wsL.Cells(r, colVoy).Value), "")
        svc = IIf(colSvc > 0, CleanText(wsL.Cells(r, colSvc).Value), "")
        dir = IIf(colDir > 0, CleanText(wsL.Cells(r, colDir).Value), "")
        bth = CleanText(wsL.Cells(r, colBTH).Value)
        term = TerminalFromBerth(bth)

        etbStr = ""
        etuStr = ""
        If colEtb > 0 Then
            If IsDate(wsL.Cells(r, colEtb).Value) Then
                etbStr = Format(wsL.Cells(r, colEtb).Value, "dd/mm/yyyy hh:mm")
            Else
                etbStr = CleanText(wsL.Cells(r, colEtb).Value)
            End If
        End If
        If colEtu > 0 Then
            If IsDate(wsL.Cells(r, colEtu).Value) Then
                etuStr = Format(wsL.Cells(r, colEtu).Value, "dd/mm/yyyy hh:mm")
            Else
                etuStr = CleanText(wsL.Cells(r, colEtu).Value)
            End If
        End If

        html = html & "<p style='margin:14px 0 4px 0;'>&#8226; For <b>" & HtmlEncode(term) & _
               "</b>, focus to complete <b>" & HtmlEncode(vslName) & " / " & HtmlEncode(voy) & "</b></p>"

        html = html & "<table border='0' cellpadding='8' cellspacing='0' style='border-collapse:collapse;" & _
               "font-family:Calibri;font-size:10.5pt;margin-bottom:18px;'>"
        html = html & "<tr style='background-color:#1F3864;color:#FFFFFF;font-weight:bold;text-align:center;'>" & _
               "<th>VESSEL / VOYAGE<br><span style='font-weight:normal;font-size:9pt;'>SVC-DIR</span></th>" & _
               "<th>ETB</th><th>ETU</th><th>BERTH</th><th>LOAD VOLUME</th>" & _
               "<th>LOAD<br>OVERSTOW</th><th>PORTMARK<br>OVERSTOW</th>" & _
               "<th>MIX WEIGHT<br>OVERSTOW</th><th>PHANTOM<br>LOCATION</th></tr>"

        html = html & "<tr style='background-color:#F3E5F5;text-align:center;'>"
        html = html & "<td style='text-align:left;'><b>" & HtmlEncode(vslName) & " / " & HtmlEncode(voy) & "</b><br>" & _
               HtmlEncode(svc) & "-" & HtmlEncode(dir) & "</td>"
        html = html & "<td>" & HtmlEncode(etbStr) & "</td>"
        html = html & "<td>" & HtmlEncode(etuStr) & "</td>"
        html = html & "<td>" & HtmlEncode(bth) & "</td>"
        html = html & "<td>" & HtmlEncode(IIf(colVol > 0, CStr(wsL.Cells(r, colVol).Value), "")) & "</td>"
        html = html & "<td>" & HtmlEncode(CStr(CLng(lo))) & "</td>"
        html = html & "<td>" & HtmlEncode(CStr(CLng(po))) & "</td>"
        html = html & "<td>" & HtmlEncode(CStr(CLng(mwo))) & "</td>"
        html = html & "<td>" & HtmlEncode(CStr(CLng(phantom))) & "</td>"
        html = html & "</tr></table>"
NextCardRow:
    Next r
    html = html & "<p style='margin:10px 0 0 0;'>Once SPD advise to cut for shifting, please float up loading containers by shuffling to resolve any overstow.</p>"
    html = html & "<p style='margin:6px 0 0 0;'><b>P456SE team:</b> Kindly review and advise on the PM support to ensure timely completion of IYS shifting.</p>"
    html = html & "<p style='margin:6px 0 12px 0;'>IYS team, <b>@MOHAMED SAH BIN BANI, YOD</b>, <b>@TAN CHIN SIONG, YOD</b>, kindly take note of the vessel priority to shift and update in your shift report on balance to shift or completed.</p>"

    BuildVesselCardsHtml = html
End Function

