            cellTxt = CleanText(rawVal)

            If Len(cellTxt) > 0 Then
                fillVals(lvl) = cellTxt
                If lvl = etbCol Then etbFillDate = rawVal
                If lvl = etuCol Then etuFillDate = rawVal
            End If

        Next lvl

        If Len(leafVal) = 0 Then GoTo NextRLoop
        If InStr(1, fillVals(nRowLevels), "total", vbTextCompare) > 0 Then GoTo NextRLoop
        If InStr(1, leafVal, "total", vbTextCompare) > 0 Then GoTo NextRLoop
        If InStr(1, leafVal, "Count of", vbTextCompare) > 0 Then GoTo NextRLoop

        Dim isFieldNameRow As Boolean
        isFieldNameRow = False

        Dim ft As Long

        For lvl = 1 To nRowLevels

            For ft = LBound(fieldNameTokens) To UBound(fieldNameTokens)

                If StrComp(Trim$(fillVals(lvl)), _
                           CStr(fieldNameTokens(ft)), _
                           vbTextCompare) = 0 Then

                    isFieldNameRow = True
                    Exit For

                End If

            Next ft

            If isFieldNameRow Then Exit For

        Next lvl

        If isFieldNameRow Then GoTo NextRLoop

        '=== VESSEL NAME FILTER (matches Vsl_Voy2, e.g. "CMA DEBUSSY(HMG1S1-V)") ===
        If Not MatchesAnyVessel(fillVals(vslCol), filterStr) Then GoTo NextRLoop
        '=============================================================================

        '=== DATE FILTER (row's stay = ETB2 -> ETU2 must overlap the requested range) ===
        If hasDateFilter Then
            If Not (IsDate(etbFillDate) And IsDate(etuFillDate)) Then GoTo NextRLoop
            If Not DateRangesOverlap(CDate(etbFillDate), CDate(etuFillDate), _
                                      hasDateFilter, dateFrom, dateTo) Then GoTo NextRLoop
        End If
        '================================================================================

        Dim rowKey As String

        rowKey = fillVals(etbCol) & "||" & _
                 fillVals(etuCol) & "||" & _
                 fillVals(vslCol)

        Dim totalsArr() As Double

        If dictAgg.Exists(rowKey) Then
            totalsArr = dictAgg(rowKey)
        Else
            ReDim totalsArr(1 To nCols)
            keyOrder.Add rowKey
        End If

        For cIdx = 1 To nCols

            Dim cVal As Variant
            cVal = dataRng.Cells(r, cIdx).Value

            If IsNumeric(cVal) Then
                totalsArr(cIdx) = totalsArr(cIdx) + CDbl(cVal)
            End If

        Next cIdx

        dictAgg(rowKey) = totalsArr

NextRLoop:
    Next r

    '--- Build HTML body rows ---
    Dim bodyRows As String
    Dim anyRow As Boolean

    anyRow = False

    Dim kk As Variant

    For Each kk In keyOrder

        Dim labels() As String
        labels = Split(CStr(kk), "||")

        Dim arrTot() As Double
        arrTot = dictAgg(kk)

        Dim hasAny As Boolean
        hasAny = False

        Dim rowTotal As Double
        rowTotal = 0

        Dim rowHtml As String

        rowHtml = "<tr style='background-color:#FFF3E0;'>"

        rowHtml = rowHtml & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & _
            HtmlEncode(labels(0)) & "</td>"

        rowHtml = rowHtml & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & _
            HtmlEncode(labels(1)) & "</td>"

        rowHtml = rowHtml & _
            "<td style='text-align:left;padding:8px;white-space:nowrap;'>" & _
            HtmlEncode(labels(2)) & "</td>"

        For cIdx = 1 To nCols

            If arrTot(cIdx) > 0 Then

                hasAny = True
                rowTotal = rowTotal + arrTot(cIdx)

                rowHtml = rowHtml & _
                    "<td style='text-align:center;padding:8px;color:#C00000;font-weight:bold;'>" & _
                    HtmlEncode(CStr(CLng(arrTot(cIdx)))) & _
                    "</td>"

            Else

                rowHtml = rowHtml & _
                    "<td style='text-align:center;padding:8px;'>&nbsp;</td>"

            End If

        Next cIdx

        rowHtml = rowHtml & _
            "<td style='text-align:center;padding:8px;color:#C00000;font-weight:bold;'>" & _
            HtmlEncode(CStr(CLng(rowTotal))) & _
            "</td>"

        rowHtml = rowHtml & "</tr>"

        If hasAny Then
            bodyRows = bodyRows & rowHtml
            anyRow = True
        End If

    Next kk

    If Not anyRow Then
        BuildSelfServiceRedBlockHtml = ""
        Exit Function
    End If

    Dim totalCols As Long
    totalCols = 3 + nCols + 1

    Dim html As String

    html = "<br><br><p><b>Long Haul <span style='color:red;font-weight:bold;'>&gt;3km</span> to shift out due to <span style='color:red;font-weight:bold;'>top priority vessel</span></b></p>"
    Dim longHaulFilterBits As String
    If Len(filterStr) > 0 Then
        longHaulFilterBits = "vessel(s): " & Replace(filterStr, "|", ", ")
    End If
    If hasDateFilter Then
        If Len(longHaulFilterBits) > 0 Then longHaulFilterBits = longHaulFilterBits & "; "
        longHaulFilterBits = longHaulFilterBits & "date: " & DateFilterDisplayText(hasDateFilter, dateFrom, dateTo)
    End If
    If Len(longHaulFilterBits) > 0 Then
        html = html & "  <span style='font-weight:normal;'>(filtered to " & _
               HtmlEncode(longHaulFilterBits) & ")</span>"
    End If
    html = html & "</p>"

    html = html & _
        "<table border='1' cellpadding='8' cellspacing='0' " & _
        "style='border-collapse:collapse;font-family:Calibri;font-size:10.5pt;'>"

    html = html & _
        "<tr><td colspan='" & totalCols & "' " & _
        "style='background-color:#FF8C00;color:#FFFFFF;font-weight:bold;text-align:center;font-size:12pt;padding:10px;'>" & _
        "Long Haul</td></tr>"

    html = html & _
        "<tr style='background-color:#FFD580;font-weight:bold;'>"

    html = html & _
        "<td colspan='3' style='text-align:left;padding:8px;'>" & _
        HtmlEncode(valCaption) & "</td>"

    html = html & _
        "<td colspan='" & nCols & "' style='text-align:center;padding:8px;'>" & _
        HtmlEncode(colFieldCaption) & "</td>"

    html = html & _
        "<td style='padding:8px;'>&nbsp;</td>"

    html = html & "</tr>"

    html = html & _
        "<tr style='background-color:#FFD580;font-weight:bold;'>"

    html = html & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>ETB2</th>"

    html = html & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>ETU2</th>"

    html = html & _
        "<th style='text-align:left;padding:8px;white-space:nowrap;'>Vsl_Voy2</th>"

    For cIdx = 1 To nCols
        html = html & _
            "<th style='text-align:center;padding:8px;'>" & _
            HtmlEncode(blockHeaders(cIdx)) & _
            "</th>"
    Next cIdx

    html = html & _
        "<th style='text-align:center;padding:8px;'>Grand Total</th>"

    html = html & "</tr>"

    html = html & bodyRows
    html = html & "</table>"

    BuildSelfServiceRedBlockHtml = html

End Function
 

